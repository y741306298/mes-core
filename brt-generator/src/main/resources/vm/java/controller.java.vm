package ${packageName}.controller;

import com.brt.common.annotation.RepeatSubmit;
import com.brt.common.annotation.RequestSingleParam;
import com.brt.common.enums.BusinessType;
import lombok.RequiredArgsConstructor;
import java.util.List;
import javax.servlet.http.HttpServletResponse;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import com.brt.common.annotation.Log;
import com.brt.common.core.controller.BaseController;
import com.brt.common.core.domain.AjaxResult;
import ${packageName}.vo.${ClassName}Vo;
import ${packageName}.service.I${ClassName}Service;
import com.brt.common.utils.poi.ExcelUtil;
#if($table.crud || $table.sub)
import com.brt.common.core.page.TableDataInfo;
#elseif($table.tree)
#end

/**
 * ${functionName}Controller
 * 
 * @author ${author}
 * @date ${datetime}
 */
@RestController
@RequestMapping("/${moduleName}/${businessName}")
@RequiredArgsConstructor(onConstructor_ = @Autowired)
public class ${ClassName}Controller extends BaseController {

    private final I${ClassName}Service ${className}Service;

    /**
     * @description: TODO 分页查询${functionName}列表
     * @author: ${author}
     * @date: ${datetime}
     * @param:
     * @param: ${className}Vo ${functionName}
     * @return:
     * @return com.brt.common.core.page.TableDataInfo<${ClassName}Vo>
     **/
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:list')")
    @GetMapping("/list")
#if($table.crud || $table.sub)
    public TableDataInfo<${ClassName}Vo> list(${ClassName}Vo ${className}Vo) {
        return ${className}Service.query${ClassName}List(${className}Vo);
    }
#elseif($table.tree)
    public AjaxResult list(${ClassName}Vo ${className}Vo) {
        return AjaxResult.success("查询成功", ${className}Service.query${ClassName}All(${className}Vo));
    }
#end

    /**
     * @description: TODO 查询全部${functionName}列表
     * @author: ${author}
     * @date: ${datetime}
     * @param:
     * @param: ${className}Vo ${functionName}
     * @return:
     * @return com.brt.common.core.domain.AjaxResult
     **/
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:list')")
    @GetMapping("/listAll")
    public AjaxResult listAll(${ClassName}Vo ${className}Vo) {
        return AjaxResult.success("查询成功", ${className}Service.query${ClassName}All(${className}Vo));
    }

    /**
     * @description: TODO 导出${functionName}列表
     * @author: FanGN
     * @date: 10:48 2023/6/12
     * @param:
     * @param: response
     * @param: ${className}Vo ${functionName}
     * @return:
     **/
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:export')")
    @Log(title = "${functionName}", businessType = BusinessType.EXPORT)
    @PostMapping("/export")
    @RepeatSubmit
    public void export(HttpServletResponse response, ${ClassName}Vo ${className}Vo){
        List<${ClassName}Vo> list = ${className}Service.query${ClassName}All(${className}Vo);
        ExcelUtil<${ClassName}Vo> util = new ExcelUtil<${ClassName}Vo>(${ClassName}Vo.class);
        util.exportExcel(response, list, "${functionName}数据");
    }


    /**
     * @description: TODO 获取${functionName}详细信息
     * @author: ${author}
     * @date: ${datetime}
     * @param:
     * @return:
     * @return com.brt.common.core.domain.AjaxResult
     **/
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:query')")
    @GetMapping(value = "/{${pkColumn.javaField}}")
    public AjaxResult getInfo(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField}) {
        return success(${className}Service.query${ClassName}By${pkColumn.capJavaField}(${pkColumn.javaField}));
    }

    /**
     * @description: TODO 新增${functionName}
     * @author: ${author}
     * @date: ${datetime}
     * @param:
     * @param: ${className}Vo ${functionName}
     * @return:
     * @return null
     **/
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:add')")
    @Log(title = "${functionName}", businessType = BusinessType.INSERT)
    @PostMapping
    @RepeatSubmit
    public AjaxResult add(@RequestBody ${ClassName}Vo ${className}Vo) {
        return AjaxResult.success(${className}Service.insert${ClassName}(${className}Vo));
    }

    /**
     * @description: TODO 修改${functionName}
     * @author: ${author}
     * @date: ${datetime}
     * @param:
     * @param: ${className}Vo ${functionName}
     * @return:
     * @return null
     **/
    @RepeatSubmit
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:edit')")
    @Log(title = "${functionName}", businessType = BusinessType.UPDATE)
    @PutMapping
    public AjaxResult edit(@RequestBody ${ClassName}Vo ${className}Vo) {
        return AjaxResult.success(${className}Service.update${ClassName}(${className}Vo));
    }

    /**
     * @description: TODO 删除${functionName}
     * @author: ${author}
     * @date: ${datetime}
     * @param:
     * @param: ${pkColumn.javaField}s
     * @return:
     * @return null
     **/
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:remove')")
    @Log(title = "${functionName}", businessType = BusinessType.DELETE)
	@DeleteMapping("/{${pkColumn.javaField}s}")
    @RepeatSubmit
    public AjaxResult remove(@PathVariable ${pkColumn.javaType}[] ${pkColumn.javaField}s){
        return toAjax(${className}Service.delete${ClassName}By${pkColumn.capJavaField}s(${pkColumn.javaField}s));
    }

}
