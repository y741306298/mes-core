import java.util.Arrays;
import java.util.List;

/**
 * ${functionName}Service业务层处理
 * 
 * @author ${author}
 * @date ${datetime}
 */
@Service
public class ${ClassName}ServiceImpl extends ServiceImpl<${ClassName}Mapper, ${ClassName}> implements I${ClassName}Service {

    @Override
    public TableDataInfo<${ClassName}Vo> query${ClassName}List(${ClassName}Vo ${className}Vo) {
        return PageUtils.buildDataInfo(this.baseMapper.query${ClassName}List(PageUtils.buildPage(), ${className}Vo));
    }

    @Override
    public List<${ClassName}Vo> query${ClassName}All(${ClassName}Vo ${className}Vo) {
        return this.baseMapper.query${ClassName}List(${className}Vo);
    }

    @Override
    public ${ClassName}Vo query${ClassName}By${pkColumn.capJavaField}(${pkColumn.javaType} ${pkColumn.javaField}) {
        return this.baseMapper.query${ClassName}By${pkColumn.capJavaField}(${pkColumn.javaField});
    }

    @Transactional
    @Override
    public ${ClassName}Vo insert${ClassName}(${ClassName}Vo ${className}Vo) {
        saveBefore(${className}Vo);
        int i = this.baseMapper.insert(${className}Vo);
        return ${className}Vo;
    }

    @Transactional
    @Override
    public ${ClassName}Vo update${ClassName}(${ClassName}Vo ${className}Vo) {
        saveBefore(${className}Vo);
        int i = this.baseMapper.updateById(${className}Vo);
        return ${className}Vo;
    }

    @Transactional
    @Override
    public int delete${ClassName}By${pkColumn.capJavaField}s(${pkColumn.javaType}[] ${pkColumn.javaField}s) {
        return this.baseMapper.deleteBatchIds(Arrays.asList(${pkColumn.javaField}s));
    }

    /**
