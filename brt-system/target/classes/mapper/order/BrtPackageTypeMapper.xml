<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtPackageTypeMapper">
    
    <resultMap type="com.brt.order.vo.BrtPackageTypeVo" id="BrtPackageTypeResult">
        <result property="typeId"    column="type_id"    />
        <result property="typeName"    column="type_name"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="brtPackageTypeAllField">
            A.type_id,
            A.type_name,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtPackageTypeQuerySql">
        select <include refid="brtPackageTypeAllField"/>
        from brt_package_type A
    </sql>

    <select id="queryBrtPackageTypeList" parameterType="com.brt.order.vo.BrtPackageTypeVo" resultMap="BrtPackageTypeResult">
        <include refid="brtPackageTypeQuerySql"/>
        <where>  
            <if test="brtPackageTypeVo.typeName != null  and brtPackageTypeVo.typeName != ''"> and A.type_name like concat('%', #{brtPackageTypeVo.typeName}, '%')</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtPackageTypeByTypeId" resultMap="BrtPackageTypeResult">
        <include refid="brtPackageTypeQuerySql"/>
        where A.type_id = #{TypeId}
    </select>
</mapper>