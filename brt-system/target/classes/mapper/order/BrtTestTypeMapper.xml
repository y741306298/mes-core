<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtTestTypeMapper">
    
    <resultMap type="com.brt.order.vo.BrtTestTypeVo" id="BrtTestTypeResult">
        <result property="typeId"    column="type_id"    />
        <result property="typeName"    column="type_name"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="brtTestTypeAllField">
            A.type_id,
            A.type_name,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtTestTypeQuerySql">
        select <include refid="brtTestTypeAllField"/>
        from brt_test_type A
    </sql>

    <select id="queryBrtTestTypeList" parameterType="com.brt.order.vo.BrtTestTypeVo" resultMap="BrtTestTypeResult">
        <include refid="brtTestTypeQuerySql"/>
        <where>  
            <if test="brtTestTypeVo.typeName != null  and brtTestTypeVo.typeName != ''"> and A.type_name like concat('%', #{brtTestTypeVo.typeName}, '%')</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtTestTypeByTypeId" resultMap="BrtTestTypeResult">
        <include refid="brtTestTypeQuerySql"/>
        where A.type_id = #{TypeId}
    </select>
</mapper>