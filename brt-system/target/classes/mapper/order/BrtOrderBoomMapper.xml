<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOrderBoomMapper">

    <resultMap type="com.brt.order.vo.BrtOrderBoomVo" id="BrtOrderBoomResult">
        <result property="boomId"    column="boom_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderType"    column="order_type"    />
        <result property="materielId"    column="materiel_id"    />
        <result property="materielName"    column="materiel_name"    />
        <result property="materielSpec"    column="materiel_spec"    />
        <result property="isCriterion"    column="is_criterion"    />
        <result property="boomNum"    column="boom_num"    />
        <result property="totalNum"    column="total_num"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="isLock"    column="is_lock"    />
    </resultMap>

    <sql id="brtOrderBoomAllField">
            A.boom_id,
            A.order_id,
            A.order_type,
            A.materiel_id,
            A.materiel_name,
            A.materiel_spec,
            A.is_criterion,
            A.boom_num,
            A.total_num,
            A.create_time,
            A.create_by,
            A.update_time,
            A.update_by,
            A.is_lock
    </sql>

    <sql id="brtOrderBoomQuerySql">
        select <include refid="brtOrderBoomAllField"/>
        from brt_order_boom A
    </sql>

    <select id="queryBrtOrderBoomList" parameterType="com.brt.order.vo.BrtOrderBoomVo" resultMap="BrtOrderBoomResult">
        <include refid="brtOrderBoomQuerySql"/>
        <where>
            <if test="brtOrderBoomVo.isLock != null  and brtOrderBoomVo.isLock != ''"> and A.is_lock = #{brtOrderBoomVo.isLock}</if>
            <if test="brtOrderBoomVo.orderId != null  and brtOrderBoomVo.orderId != ''"> and A.order_id = #{brtOrderBoomVo.orderId}</if>
            <if test="brtOrderBoomVo.orderType != null  and brtOrderBoomVo.orderType != ''"> and A.order_type = #{brtOrderBoomVo.orderType}</if>
            <if test="brtOrderBoomVo.materielId != null  and brtOrderBoomVo.materielId != ''"> and A.materiel_id = #{brtOrderBoomVo.materielId}</if>
            <if test="brtOrderBoomVo.boomNum != null "> and A.boom_num = #{brtOrderBoomVo.boomNum}</if>
            <if test="brtOrderBoomVo.totalNum != null "> and A.total_num = #{brtOrderBoomVo.totalNum}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOrderBoomByBoomId" resultMap="BrtOrderBoomResult">
        <include refid="brtOrderBoomQuerySql"/>
        where A.boom_id = #{BoomId}
    </select>

    <select id="queryBrtOrderBoomByOrderDetailsId" resultMap="BrtOrderBoomResult">
        <include refid="brtOrderBoomQuerySql"/>
        where A.order_details_id = #{orderDetailsId}
    </select>
</mapper>
