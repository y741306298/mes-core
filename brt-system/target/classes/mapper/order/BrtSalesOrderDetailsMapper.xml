<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtSalesOrderDetailsMapper">

    <resultMap type="com.brt.order.vo.BrtSalesOrderDetailsVo" id="BrtSalesOrderDetailsResult">
        <result property="detailsId"    column="details_id"    />
        <result property="detailsNo"    column="details_no"    />
        <result property="orderId"    column="order_id"    />
        <result property="materielId"    column="materiel_id"    />
        <result property="materielType"    column="materiel_type"    />
        <result property="materielSize"    column="materiel_size"    />
        <result property="yieldNo"    column="yield_no"    />
        <result property="drawingNo"    column="drawing_no"    />
        <result property="customerPn"    column="customer_pn"    />
        <result property="detailsNum"    column="details_num"    />
        <result property="materielUnit"    column="materiel_unit"    />
        <result property="detailsPrice"    column="details_price"    />
        <result property="detailsAmount"    column="details_amount"    />
        <result property="packageModel"    column="package_model"    />
        <result property="packageTypeId"    column="package_type_id"    />
        <result property="packageSize"    column="package_size"    />
        <result property="pagkageNum"    column="pagkage_num"    />
        <result property="testTypeId"    column="test_type_id"    />
        <result property="testMode"    column="test_mode"    />
        <result property="detailsRemark"    column="details_remark"    />
        <result property="attachments"    column="attachments"    />
        <result property="boomFile"    column="boom_file"    />
        <result property="jobDrawing"    column="job_drawing"    />
        <result property="jobProgram"    column="job_program"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <association property="materielVo" javaType="com.brt.order.vo.BrtMaterielVo" column="materiel_id" select="com.brt.order.mapper.BrtMaterielMapper.queryBrtMaterielByMaterielId" />
        <collection property="boomVoList" ofType="com.brt.order.vo.BrtOrderBoomVo" column="details_id" select="com.brt.order.mapper.BrtOrderBoomMapper.queryBrtOrderBoomByOrderDetailsId" />
    </resultMap>

    <resultMap type="com.brt.order.vo.BrtSalesOrderDetailsVo" id="statementBrtSalesOrderDetailsResult" extends="BrtSalesOrderDetailsResult">
        <result column="customer_name" property="customerName"/>
        <association property="salesOrderVo" javaType="com.brt.order.vo.BrtSalesOrderVo">
            <result column="order_id" property="orderId"/>
            <result column="order_no" property="orderNo"/>
            <result column="order_time" property="orderTime"/>
            <result column="total_num" property="totalNum"/>
            <result column="total_amount" property="totalAmount"/>
            <result column="template_id" property="templateId"/>
        </association>
        <association property="user" javaType="com.brt.common.core.domain.entity.SysUser" column="user_id" select="com.brt.system.mapper.SysUserMapper.selectUserById" />
    </resultMap>

    <sql id="brtSalesOrderDetailsAllField">
            A.details_id,
            A.details_no,
            A.order_id,
            A.materiel_id,
            A.materiel_type,
            A.materiel_size,
            A.yield_no,
            A.drawing_no,
            A.customer_pn,
            A.details_num,
            A.materiel_unit,
            A.details_price,
            A.details_amount,
            A.package_model,
            A.package_type_id,
            A.package_size,
            A.pagkage_num,
            A.test_type_id,
            A.test_mode,
            A.details_remark,
            A.attachments,
            A.boom_file,
            A.job_drawing,
            A.job_program,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtSalesOrderDetailsQuerySql">
        select <include refid="brtSalesOrderDetailsAllField"/>
        from brt_sales_order_details A
    </sql>

    <sql id="brtSalesOrderDetailsWhereSql">
        <if test="brtSalesOrderDetailsVo.detailsNo != null  and brtSalesOrderDetailsVo.detailsNo != ''"> and A.details_no = #{brtSalesOrderDetailsVo.detailsNo}</if>
        <if test="brtSalesOrderDetailsVo.orderId != null  and brtSalesOrderDetailsVo.orderId != ''"> and A.order_id = #{brtSalesOrderDetailsVo.orderId}</if>
        <if test="brtSalesOrderDetailsVo.materielId != null  and brtSalesOrderDetailsVo.materielId != ''"> and A.materiel_id = #{brtSalesOrderDetailsVo.materielId}</if>
        <if test="brtSalesOrderDetailsVo.materielType != null  and brtSalesOrderDetailsVo.materielType != ''"> and A.materiel_type = #{brtSalesOrderDetailsVo.materielType}</if>
        <if test="brtSalesOrderDetailsVo.materielSize != null  and brtSalesOrderDetailsVo.materielSize != ''"> and A.materiel_size = #{brtSalesOrderDetailsVo.materielSize}</if>
        <if test="brtSalesOrderDetailsVo.yieldNo != null  and brtSalesOrderDetailsVo.yieldNo != ''"> and A.yield_no = #{brtSalesOrderDetailsVo.yieldNo}</if>
        <if test="brtSalesOrderDetailsVo.drawingNo != null  and brtSalesOrderDetailsVo.drawingNo != ''"> and A.drawing_no = #{brtSalesOrderDetailsVo.drawingNo}</if>
        <if test="brtSalesOrderDetailsVo.customerPn != null  and brtSalesOrderDetailsVo.customerPn != ''"> and A.customer_pn = #{brtSalesOrderDetailsVo.customerPn}</if>
        <if test="brtSalesOrderDetailsVo.detailsNum != null "> and A.details_num = #{brtSalesOrderDetailsVo.detailsNum}</if>
        <if test="brtSalesOrderDetailsVo.materielUnit != null  and brtSalesOrderDetailsVo.materielUnit != ''"> and A.materiel_unit = #{brtSalesOrderDetailsVo.materielUnit}</if>
        <if test="brtSalesOrderDetailsVo.detailsPrice != null "> and A.details_price = #{brtSalesOrderDetailsVo.detailsPrice}</if>
        <if test="brtSalesOrderDetailsVo.detailsAmount != null "> and A.details_amount = #{brtSalesOrderDetailsVo.detailsAmount}</if>
        <if test="brtSalesOrderDetailsVo.packageModel != null  and brtSalesOrderDetailsVo.packageModel != ''"> and A.package_model = #{brtSalesOrderDetailsVo.packageModel}</if>
        <if test="brtSalesOrderDetailsVo.packageTypeId != null  and brtSalesOrderDetailsVo.packageTypeId != ''"> and A.package_type_id = #{brtSalesOrderDetailsVo.packageTypeId}</if>
        <if test="brtSalesOrderDetailsVo.packageSize != null  and brtSalesOrderDetailsVo.packageSize != ''"> and A.package_size = #{brtSalesOrderDetailsVo.packageSize}</if>
        <if test="brtSalesOrderDetailsVo.pagkageNum != null "> and A.pagkage_num = #{brtSalesOrderDetailsVo.pagkageNum}</if>
        <if test="brtSalesOrderDetailsVo.testTypeId != null  and brtSalesOrderDetailsVo.testTypeId != ''"> and A.test_type_id = #{brtSalesOrderDetailsVo.testTypeId}</if>
        <if test="brtSalesOrderDetailsVo.testMode != null  and brtSalesOrderDetailsVo.testMode != ''"> and A.test_mode = #{brtSalesOrderDetailsVo.testMode}</if>
        <if test="brtSalesOrderDetailsVo.detailsRemark != null  and brtSalesOrderDetailsVo.detailsRemark != ''"> and A.details_remark = #{brtSalesOrderDetailsVo.detailsRemark}</if>
    </sql>

    <select id="queryBrtSalesOrderDetailsList" parameterType="com.brt.order.vo.BrtSalesOrderDetailsVo" resultMap="BrtSalesOrderDetailsResult">
        <include refid="brtSalesOrderDetailsQuerySql"/>
        <where>
            <include refid="brtSalesOrderDetailsWhereSql" />
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtSalesOrderDetailsByDetailsId" resultMap="BrtSalesOrderDetailsResult">
        <include refid="brtSalesOrderDetailsQuerySql"/>
        where A.details_id = #{DetailsId}
    </select>

    <select id="statementList" resultMap="statementBrtSalesOrderDetailsResult">
        select <include refid="brtSalesOrderDetailsAllField"/>,
               o.order_no,o.order_time,o.total_num,o.total_amount,o.user_id,o.template_id,
               c.customer_name
        from brt_sales_order_details A
        inner join brt_sales_order o on A.order_id = o.order_id
        left join brt_customer c on o.customer_id = c.customer_id
        <where>
            <include refid="brtSalesOrderDetailsWhereSql" />
            <if test="brtSalesOrderDetailsVo.dateType != null and brtSalesOrderDetailsVo.dateType != ''">
                <choose>
                    <when test="brtSalesOrderDetailsVo.dateType == '0'.toString() ">
                        and date_format(o.order_time,'%y%m%d') = date_format(now(),'%y%m%d')
                    </when>
                    <when test="brtSalesOrderDetailsVo.dateType == '1'.toString() ">
                        and DATE(o.order_time) = CURDATE() - INTERVAL 1 DAY
                    </when>
                    <when test="brtSalesOrderDetailsVo.dateType == '2'.toString() ">
                        and date_format(o.order_time,'%y%m') = date_format(now(),'%y%m')
                    </when>
                    <when test="brtSalesOrderDetailsVo.dateType == '3'.toString() ">
                        and QUARTER(o.order_time) = QUARTER(CURDATE()) and YEAR(o.order_time) = YEAR(CURDATE())
                    </when>
                    <when test="brtSalesOrderDetailsVo.dateType == '4'.toString() ">
                        and YEAR(o.order_time) = YEAR(CURDATE())
                    </when>
                </choose>
            </if>
            <if test="brtSalesOrderDetailsVo.createTimeStart != null and brtSalesOrderDetailsVo.createTimeStart != '' and brtSalesOrderDetailsVo.createTimeEnd != null and brtSalesOrderDetailsVo.createTimeEnd != ''">
                and date_format(o.order_time,'%y%m%d') between date_format(#{brtSalesOrderDetailsVo.createTimeStart},'%y%m%d') and date_format(#{brtSalesOrderDetailsVo.createTimeEnd},'%y%m%d')
            </if>
            <if test="brtSalesOrderDetailsVo.customerId != null and brtSalesOrderDetailsVo.customerId != ''">
                and o.customer_id = #{brtSalesOrderDetailsVo.customerId}
            </if>
            <if test="brtSalesOrderDetailsVo.customerTypeId != null and brtSalesOrderDetailsVo.customerTypeId != ''">
                and c.type_id = #{brtSalesOrderDetailsVo.customerTypeId}
            </if>
            <if test="brtSalesOrderDetailsVo.userId != null and brtSalesOrderDetailsVo.userId != ''">
                and o.user_id = #{brtSalesOrderDetailsVo.userId}
            </if>
        </where>
        order by A.create_time desc
    </select>

    <select id="getBrtSalesOrderDetailsVoListByOrderId" parameterType="String" resultMap="BrtSalesOrderDetailsResult">
        select * from brt_sales_order_details where order_id = #{orderId}
    </select>

</mapper>
