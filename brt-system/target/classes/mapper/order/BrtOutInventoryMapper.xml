<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOutInventoryMapper">

    <resultMap type="com.brt.order.vo.BrtOutInventoryVo" id="BrtOutInventoryResult">
        <result property="outInventoryId"    column="out_inventory_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="outInventoryNo"    column="out_inventory_no"    />
        <result property="outInventoryType"    column="out_inventory_type"    />
        <result property="outInventoryStatus"    column="out_inventory_status"    />
        <result property="applicat"    column="applicat"    />
        <result property="applyTime"    column="apply_time"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="files"    column="files"    />
        <result property="uploadType"    column="upload_type"    />
        <association property="user" javaType="com.brt.common.core.domain.entity.SysUser" column="applicat" select="com.brt.system.mapper.SysUserMapper.selectUserById" />

        <association property="salesOrder" javaType="com.brt.order.vo.BrtSalesOrderVo" column="order_id" select="com.brt.order.mapper.BrtSalesOrderMapper.queryBrtSalesOrderByOrderId" />

    </resultMap>

    <sql id="brtOutInventoryAllField">
            A.out_inventory_id,
            A.order_id,
            A.out_inventory_no,
            A.out_inventory_type,
            A.out_inventory_status,
            A.applicat,
            A.apply_time,
            A.remark,
            A.create_time,
            A.create_by,
            A.update_time,
            A.update_by,
            A.files,
            A.upload_type
    </sql>

    <sql id="brtOutInventoryQuerySql">
        select <include refid="brtOutInventoryAllField"/>
        from brt_out_inventory A
    </sql>

    <select id="queryBrtOutInventoryList" parameterType="com.brt.order.vo.BrtOutInventoryVo" resultMap="BrtOutInventoryResult">
        <include refid="brtOutInventoryQuerySql"/>
        <where>
            <if test="brtOutInventoryVo.orderId != null  and brtOutInventoryVo.orderId != ''"> and A.order_id = #{brtOutInventoryVo.orderId}</if>
            <if test="brtOutInventoryVo.outInventoryNo != null  and brtOutInventoryVo.outInventoryNo != ''"> and A.out_inventory_no like concat('%',#{brtOutInventoryVo.outInventoryNo},'%')</if>
            <if test="brtOutInventoryVo.outInventoryType != null  and brtOutInventoryVo.outInventoryType != ''"> and A.out_inventory_type = #{brtOutInventoryVo.outInventoryType}</if>
            <if test="brtOutInventoryVo.outInventoryStatus != null  and brtOutInventoryVo.outInventoryStatus != ''"> and A.out_inventory_status = #{brtOutInventoryVo.outInventoryStatus}</if>
            <if test="brtOutInventoryVo.applicat != null  and brtOutInventoryVo.applicat != ''"> and A.applicat = #{brtOutInventoryVo.applicat}</if>
            <if test="brtOutInventoryVo.applyTime != null "> and A.apply_time = #{brtOutInventoryVo.applyTime}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOutInventoryByOutInventoryId" resultMap="BrtOutInventoryResult">
        <include refid="brtOutInventoryQuerySql"/>
        where A.out_inventory_id = #{OutInventoryId}
    </select>
</mapper>
