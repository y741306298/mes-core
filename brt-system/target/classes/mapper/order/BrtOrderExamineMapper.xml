<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOrderExamineMapper">

    <resultMap type="com.brt.order.vo.BrtOrderExamineVo" id="BrtOrderExamineResult">
        <result property="examineId"    column="examine_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="orderType"    column="order_type"    />
        <result property="childId"    column="child_id"    />
        <result property="customerId"    column="customer_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="orderAmount"    column="order_amount"    />
        <result property="orderDate"    column="order_date"    />
        <result property="orderRemark"    column="order_remark"    />
        <result property="auditStatus"    column="audit_status"    />
        <result property="auditUserId"    column="audit_user_id"    />
        <result property="auditRemark"    column="audit_remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <association property="customerVo" javaType="com.brt.order.vo.BrtCustomerVo" column="customer_id" select="com.brt.order.mapper.BrtCustomerMapper.queryBrtCustomerByCustomerId" />
    </resultMap>

    <sql id="brtOrderExamineAllField">
            A.examine_id,
            A.order_id,
            A.order_no,
            A.order_type,
            A.child_id,
            A.customer_id,
            A.order_num,
            A.order_amount,
            A.order_date,
            A.order_remark,
            A.audit_status,
            A.audit_user_id,
            A.audit_remark,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtOrderExamineQuerySql">
        select <include refid="brtOrderExamineAllField"/>
        from brt_order_examine A
    </sql>

    <select id="queryBrtOrderExamineList" parameterType="com.brt.order.vo.BrtOrderExamineVo" resultMap="BrtOrderExamineResult">
        <include refid="brtOrderExamineQuerySql"/>
        <where>
            <if test="brtOrderExamineVo.orderId != null  and brtOrderExamineVo.orderId != ''"> and A.order_id = #{brtOrderExamineVo.orderId}</if>
            <if test="brtOrderExamineVo.orderNo != null  and brtOrderExamineVo.orderNo != ''"> and A.order_no like concat('%',#{brtOrderExamineVo.orderNo},'%')</if>
            <if test="brtOrderExamineVo.orderType != null  and brtOrderExamineVo.orderType != ''"> and A.order_type = #{brtOrderExamineVo.orderType}</if>
            <if test="brtOrderExamineVo.childId != null  and brtOrderExamineVo.childId != ''"> and A.child_id = #{brtOrderExamineVo.childId}</if>
            <if test="brtOrderExamineVo.customerId != null  and brtOrderExamineVo.customerId != ''"> and A.customer_id = #{brtOrderExamineVo.customerId}</if>
            <if test="brtOrderExamineVo.orderNum != null "> and A.order_num = #{brtOrderExamineVo.orderNum}</if>
            <if test="brtOrderExamineVo.orderAmount != null "> and A.order_amount = #{brtOrderExamineVo.orderAmount}</if>
            <if test="brtOrderExamineVo.orderDate != null "> and A.order_date = #{brtOrderExamineVo.orderDate}</if>
            <if test="brtOrderExamineVo.orderRemark != null  and brtOrderExamineVo.orderRemark != ''"> and A.order_remark = #{brtOrderExamineVo.orderRemark}</if>
            <if test="brtOrderExamineVo.auditStatus != null  and brtOrderExamineVo.auditStatus != ''"> and A.audit_status = #{brtOrderExamineVo.auditStatus}</if>
            <if test="brtOrderExamineVo.auditUserId != null  and brtOrderExamineVo.auditUserId != ''"> and A.audit_user_id = #{brtOrderExamineVo.auditUserId}</if>
            <if test="brtOrderExamineVo.auditRemark != null  and brtOrderExamineVo.auditRemark != ''"> and A.audit_remark = #{brtOrderExamineVo.auditRemark}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOrderExamineByExamineId" resultMap="BrtOrderExamineResult">
        <include refid="brtOrderExamineQuerySql"/>
        where A.examine_id = #{ExamineId}
    </select>

    <select id="orderAllList" resultType="java.util.Map">
        select order_id as orderId,order_no as orderNo,'1' as orderType from brt_sales_order
            union all
        select order_id as orderId,order_no as orderNo,'2' as orderType from brt_market_order
            union all
        select order_id as orderId,order_no as orderNo,'0' as orderType from brt_price_sheet_order
    </select>

    <select id="auditQuery" resultMap="BrtOrderExamineResult">
        <include refid="brtOrderExamineQuerySql"/>
        left join brt_order_template ot on ot.order_template_id = A.order_template_id
        where ot.order_template_status = '0'
        <if test="orderId!=null and orderId!=''">
            and A.order_id = #{orderId}
        </if>
        <if test="childId!=null and childId!=''">
            and A.child_id = #{childId}
        </if>
    </select>

</mapper>
