<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOrderCollectionPlanMapper">
    
    <resultMap type="com.brt.order.vo.BrtOrderCollectionPlanVo" id="BrtOrderCollectionPlanResult">
        <result property="planId"    column="plan_id"    />
        <result property="nodeId"    column="node_id"    />
        <result property="orderNodeId"    column="order_node_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="orderType"    column="order_type"    />
        <result property="collectionAmount"    column="collection_amount"    />
        <result property="planAmount"    column="plan_amount"    />
        <result property="orderAmount"    column="order_amount"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="brtOrderCollectionPlanAllField">
            A.plan_id,
            A.node_id,
            A.order_node_id,
            A.order_id,
            A.order_no,
            A.order_type,
            A.collection_amount,
            A.plan_amount,
            A.order_amount,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtOrderCollectionPlanQuerySql">
        select <include refid="brtOrderCollectionPlanAllField"/>
        from brt_order_collection_plan A
    </sql>

    <select id="queryBrtOrderCollectionPlanList" parameterType="com.brt.order.vo.BrtOrderCollectionPlanVo" resultMap="BrtOrderCollectionPlanResult">
        <include refid="brtOrderCollectionPlanQuerySql"/>
        <where>
            <if test="brtOrderCollectionPlanVo.nodeId != null  and brtOrderCollectionPlanVo.nodeId != ''"> and A.node_id = #{brtOrderCollectionPlanVo.nodeId}</if>
            <if test="brtOrderCollectionPlanVo.orderNodeId != null  and brtOrderCollectionPlanVo.orderNodeId != ''"> and A.order_node_id = #{brtOrderCollectionPlanVo.orderNodeId}</if>
            <if test="brtOrderCollectionPlanVo.orderId != null  and brtOrderCollectionPlanVo.orderId != ''"> and A.order_id = #{brtOrderCollectionPlanVo.orderId}</if>
            <if test="brtOrderCollectionPlanVo.orderNo != null  and brtOrderCollectionPlanVo.orderNo != ''"> and A.order_no = #{brtOrderCollectionPlanVo.orderNo}</if>
            <if test="brtOrderCollectionPlanVo.orderType != null  and brtOrderCollectionPlanVo.orderType != ''"> and A.order_type = #{brtOrderCollectionPlanVo.orderType}</if>
            <if test="brtOrderCollectionPlanVo.collectionAmount != null "> and A.collection_amount = #{brtOrderCollectionPlanVo.collectionAmount}</if>
            <if test="brtOrderCollectionPlanVo.planAmount != null "> and A.plan_amount = #{brtOrderCollectionPlanVo.planAmount}</if>
            <if test="brtOrderCollectionPlanVo.orderAmount != null "> and A.order_amount = #{brtOrderCollectionPlanVo.orderAmount}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOrderCollectionPlanByPlanId" resultMap="BrtOrderCollectionPlanResult">
        <include refid="brtOrderCollectionPlanQuerySql"/>
        where A.plan_id = #{PlanId}
    </select>
</mapper>