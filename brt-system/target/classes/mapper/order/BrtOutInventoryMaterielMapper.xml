<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOutInventoryMaterielMapper">

    <resultMap type="com.brt.order.vo.BrtOutInventoryMaterielVo" id="BrtOutInventoryMaterielResult">
        <result property="outInventoryMaterielId"    column="out_inventory_materiel_id"    />
        <result property="materielId"    column="materiel_id"    />
        <result property="outInventoryNum"    column="out_inventory_num"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="residueNum"    column="residue_num"    />
    </resultMap>

    <sql id="brtOutInventoryMaterielAllField">
            A.out_inventory_materiel_id,
            A.materiel_id,
            A.out_inventory_num,
            A.remark,
            A.create_time,
            A.create_by,
            A.update_time,
            A.update_by,
            A.residue_num
    </sql>

    <sql id="brtOutInventoryMaterielQuerySql">
        select <include refid="brtOutInventoryMaterielAllField"/>
        from brt_out_inventory_materiel A
    </sql>

    <select id="queryBrtOutInventoryMaterielList" parameterType="com.brt.order.vo.BrtOutInventoryMaterielVo" resultMap="BrtOutInventoryMaterielResult">
        <include refid="brtOutInventoryMaterielQuerySql"/>
        <where>
            <if test="brtOutInventoryMaterielVo.materielId != null  and brtOutInventoryMaterielVo.materielId != ''"> and A.materiel_id = #{brtOutInventoryMaterielVo.materielId}</if>
            <if test="brtOutInventoryMaterielVo.outInventoryNum != null "> and A.out_inventory_num = #{brtOutInventoryMaterielVo.outInventoryNum}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOutInventoryMaterielByOutInventoryMaterielId" resultMap="BrtOutInventoryMaterielResult">
        <include refid="brtOutInventoryMaterielQuerySql"/>
        where A.out_inventory_materiel_id = #{OutInventoryMaterielId}
    </select>

    <select id="queryByOutInventoryId" resultType="com.brt.order.vo.BrtOutInventoryMaterielVo">
        SELECT
            im.out_inventory_materiel_id outInventoryMaterielId,
            im.out_inventory_id outInventoryId,
            im.materiel_id materielId,
            im.out_inventory_num outInventoryNum,
            im.remark remark,
            m.materiel_no materielNo,
            m.materiel_name materielName,
            m.materiel_spec materielSpec,
            m.type_id typeId
        FROM
            brt_out_inventory_materiel im
                LEFT JOIN brt_materiel m ON m.materiel_id = im.materiel_id
        where out_inventory_id = #{outInventoryId}
    </select>

    <select id="deleteByOutInventoryId">
        delete  from brt_out_inventory_materiel where out_inventory_id in
        <foreach collection="inventoryIds" separator="," close=")" open="(" item="item">
            #{item}
        </foreach>
    </select>


</mapper>
