<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtCustomerTypeMapper">
    
    <resultMap type="com.brt.order.vo.BrtCustomerTypeVo" id="BrtCustomerTypeResult">
        <result property="typeId"    column="type_id"    />
        <result property="typeName"    column="type_name"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="brtCustomerTypeAllField">
            A.type_id,
            A.type_name,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtCustomerTypeQuerySql">
        select <include refid="brtCustomerTypeAllField"/>
        from brt_customer_type A
    </sql>

    <select id="queryBrtCustomerTypeList" parameterType="com.brt.order.vo.BrtCustomerTypeVo" resultMap="BrtCustomerTypeResult">
        <include refid="brtCustomerTypeQuerySql"/>
        <where>  
            <if test="brtCustomerTypeVo.typeName != null  and brtCustomerTypeVo.typeName != ''"> and A.type_name like concat('%', #{brtCustomerTypeVo.typeName}, '%')</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtCustomerTypeByTypeId" resultMap="BrtCustomerTypeResult">
        <include refid="brtCustomerTypeQuerySql"/>
        where A.type_id = #{TypeId}
    </select>
</mapper>