<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOrderInvoiceRecordMapper">
    
    <resultMap type="com.brt.order.vo.BrtOrderInvoiceRecordVo" id="BrtOrderInvoiceRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="nodeId"    column="node_id"    />
        <result property="orderNodeId"    column="order_node_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderType"    column="order_type"    />
        <result property="invoiceAmount"    column="invoice_amount"    />
        <result property="surplusAmount"    column="surplus_amount"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="brtOrderInvoiceRecordAllField">
            A.record_id,
            A.node_id,
            A.order_node_id,
            A.order_id,
            A.order_type,
            A.invoice_amount,
            A.surplus_amount,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtOrderInvoiceRecordQuerySql">
        select <include refid="brtOrderInvoiceRecordAllField"/>
        from brt_order_invoice_record A
    </sql>

    <select id="queryBrtOrderInvoiceRecordList" parameterType="com.brt.order.vo.BrtOrderInvoiceRecordVo" resultMap="BrtOrderInvoiceRecordResult">
        <include refid="brtOrderInvoiceRecordQuerySql"/>
        <where>
            <if test="brtOrderInvoiceRecordVo.nodeId != null  and brtOrderInvoiceRecordVo.nodeId != ''"> and A.node_id = #{brtOrderInvoiceRecordVo.nodeId}</if>
            <if test="brtOrderInvoiceRecordVo.orderNodeId != null  and brtOrderInvoiceRecordVo.orderNodeId != ''"> and A.order_node_id = #{brtOrderInvoiceRecordVo.orderNodeId}</if>
            <if test="brtOrderInvoiceRecordVo.orderId != null  and brtOrderInvoiceRecordVo.orderId != ''"> and A.order_id = #{brtOrderInvoiceRecordVo.orderId}</if>
            <if test="brtOrderInvoiceRecordVo.orderType != null  and brtOrderInvoiceRecordVo.orderType != ''"> and A.order_type = #{brtOrderInvoiceRecordVo.orderType}</if>
            <if test="brtOrderInvoiceRecordVo.invoiceAmount != null "> and A.invoice_amount = #{brtOrderInvoiceRecordVo.invoiceAmount}</if>
            <if test="brtOrderInvoiceRecordVo.surplusAmount != null "> and A.surplus_amount = #{brtOrderInvoiceRecordVo.surplusAmount}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOrderInvoiceRecordByRecordId" resultMap="BrtOrderInvoiceRecordResult">
        <include refid="brtOrderInvoiceRecordQuerySql"/>
        where A.record_id = #{RecordId}
    </select>
</mapper>