<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtOrderInvoicePlanMapper">
    
    <resultMap type="com.brt.order.vo.BrtOrderInvoicePlanVo" id="BrtOrderInvoicePlanResult">
        <result property="planId"    column="plan_id"    />
        <result property="nodeId"    column="node_id"    />
        <result property="orderNodeId"    column="order_node_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="orderType"    column="order_type"    />
        <result property="invoiceAmount"    column="invoice_amount"    />
        <result property="planAmount"    column="plan_amount"    />
        <result property="orderAmount"    column="order_amount"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="brtOrderInvoicePlanAllField">
            A.plan_id,
            A.node_id,
            A.order_node_id,
            A.order_id,
            A.order_no,
            A.order_type,
            A.invoice_amount,
            A.plan_amount,
            A.order_amount,
            A.create_time,
            A.create_by,
            A.update_time,
        A.update_by
    </sql>

    <sql id="brtOrderInvoicePlanQuerySql">
        select <include refid="brtOrderInvoicePlanAllField"/>
        from brt_order_invoice_plan A
    </sql>

    <select id="queryBrtOrderInvoicePlanList" parameterType="com.brt.order.vo.BrtOrderInvoicePlanVo" resultMap="BrtOrderInvoicePlanResult">
        <include refid="brtOrderInvoicePlanQuerySql"/>
        <where>
            <if test="brtOrderInvoicePlanVo.nodeId != null  and brtOrderInvoicePlanVo.nodeId != ''"> and A.node_id = #{brtOrderInvoicePlanVo.nodeId}</if>
            <if test="brtOrderInvoicePlanVo.orderNodeId != null  and brtOrderInvoicePlanVo.orderNodeId != ''"> and A.order_node_id = #{brtOrderInvoicePlanVo.orderNodeId}</if>
            <if test="brtOrderInvoicePlanVo.orderId != null  and brtOrderInvoicePlanVo.orderId != ''"> and A.order_id = #{brtOrderInvoicePlanVo.orderId}</if>
            <if test="brtOrderInvoicePlanVo.orderType != null  and brtOrderInvoicePlanVo.orderType != ''"> and A.order_type = #{brtOrderInvoicePlanVo.orderType}</if>
            <if test="brtOrderInvoicePlanVo.invoiceAmount != null "> and A.invoice_amount = #{brtOrderInvoicePlanVo.invoiceAmount}</if>
            <if test="brtOrderInvoicePlanVo.planAmount != null "> and A.plan_amount = #{brtOrderInvoicePlanVo.planAmount}</if>
            <if test="brtOrderInvoicePlanVo.orderAmount != null "> and A.order_amount = #{brtOrderInvoicePlanVo.orderAmount}</if>
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtOrderInvoicePlanByPlanId" resultMap="BrtOrderInvoicePlanResult">
        <include refid="brtOrderInvoicePlanQuerySql"/>
        where A.plan_id = #{PlanId}
    </select>
</mapper>