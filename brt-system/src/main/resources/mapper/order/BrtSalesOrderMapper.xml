    <sql id="brtSalesOrderQuerySql">
        select <include refid="brtSalesOrderAllField"/>
        from brt_sales_order A
    </sql>

    <select id="queryBrtSalesOrderList" parameterType="com.brt.order.vo.BrtSalesOrderVo" resultMap="BrtSalesOrderResult">
        <include refid="brtSalesOrderQuerySql"/>
        <where>
            <if test="brtSalesOrderVo.orderNo != null  and brtSalesOrderVo.orderNo != ''"> and A.order_no like concat('%',#{brtSalesOrderVo.orderNo},'%')</if>
            <if test="brtSalesOrderVo.customerId != null  and brtSalesOrderVo.customerId != ''"> and A.customer_id = #{brtSalesOrderVo.customerId}</if>
            <if test="brtSalesOrderVo.contact != null  and brtSalesOrderVo.contact != ''"> and A.contact = #{brtSalesOrderVo.contact}</if>
            <if test="brtSalesOrderVo.contactTel != null  and brtSalesOrderVo.contactTel != ''"> and A.contact_tel = #{brtSalesOrderVo.contactTel}</if>
            <if test="brtSalesOrderVo.deliveryAddress != null  and brtSalesOrderVo.deliveryAddress != ''"> and A.delivery_address = #{brtSalesOrderVo.deliveryAddress}</if>
            <if test="brtSalesOrderVo.orderTime != null "> and A.order_time = #{brtSalesOrderVo.orderTime}</if>
            <if test="brtSalesOrderVo.deliveryTime != null "> and A.delivery_time = #{brtSalesOrderVo.deliveryTime}</if>
            <if test="brtSalesOrderVo.templateId != null  and brtSalesOrderVo.templateId != ''"> and A.template_id = #{brtSalesOrderVo.templateId}</if>
            <if test="brtSalesOrderVo.craftType != null  and brtSalesOrderVo.craftType != ''"> and A.craft_type = #{brtSalesOrderVo.craftType}</if>
            <if test="brtSalesOrderVo.totalNum != null "> and A.total_num = #{brtSalesOrderVo.totalNum}</if>
            <if test="brtSalesOrderVo.totalAmount != null "> and A.total_amount = #{brtSalesOrderVo.totalAmount}</if>
            <if test="brtSalesOrderVo.currencyType != null  and brtSalesOrderVo.currencyType != ''"> and A.currency_type = #{brtSalesOrderVo.currencyType}</if>
            <if test="brtSalesOrderVo.attachments != null  and brtSalesOrderVo.attachments != ''"> and A.attachments = #{brtSalesOrderVo.attachments}</if>
            <if test="brtSalesOrderVo.userId != null  and brtSalesOrderVo.userId != ''"> and A.user_id = #{brtSalesOrderVo.userId}</if>
            <if test="brtSalesOrderVo.collectionStatus != null and brtSalesOrderVo.collectionStatus != ''"> and A.collection_status = #{brtSalesOrderVo.collectionStatus}</if>
            <if test="brtSalesOrderVo.status != null and brtSalesOrderVo.status != ''"> and A.status = #{brtSalesOrderVo.status}</if>
            <if test="brtSalesOrderVo.dateType != null and brtSalesOrderVo.dateType != ''">
                <choose>
                    <when test="brtSalesOrderVo.dateType == '0'.toString() ">
                        and date_format(A.order_time,'%y%m%d') = date_format(now(),'%y%m%d')
                    </when>
                    <when test="brtSalesOrderVo.dateType == '1'.toString() ">
                        and DATE(A.order_time) = CURDATE() - INTERVAL 1 DAY
                    </when>
                    <when test="brtSalesOrderVo.dateType == '2'.toString() ">
                        and date_format(A.order_time,'%y%m') = date_format(now(),'%y%m')
                    </when>
                    <when test="brtSalesOrderVo.dateType == '3'.toString() ">
                        and QUARTER(A.order_time) = QUARTER(CURDATE()) and YEAR(A.order_time) = YEAR(CURDATE())
                    </when>
                    <when test="brtSalesOrderVo.dateType == '4'.toString() ">
                        and YEAR(A.order_time) = YEAR(CURDATE())
                    </when>
                </choose>
            </if>
            <if test="brtSalesOrderVo.createTimeStart != null and brtSalesOrderVo.createTimeStart != '' and brtSalesOrderVo.createTimeEnd != null and brtSalesOrderVo.createTimeEnd != ''">
                and date_format(A.order_time,'%y%m%d') between date_format(#{brtSalesOrderVo.createTimeStart},'%y%m%d') and date_format(#{brtSalesOrderVo.createTimeEnd},'%y%m%d')
            </if>
            <if test="brtSalesOrderVo.ids!=null">
                and order_id in
                <foreach collection="brtSalesOrderVo.ids" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            ${brtSalesOrderVo.params.brtDataScope}
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtSalesOrderByOrderId" resultMap="BrtSalesOrderResult">
        <include refid="brtSalesOrderQuerySql"/>
        where A.order_id = #{OrderId}
    </select>

    <select id="updateStatus" parameterType="com.brt.order.vo.BrtSalesOrderVo" >
        update brt_sales_order set status = #{brtSalesOrderVo.status}
        <if test="brtSalesOrderVo.finishDate!=null and brtSalesOrderVo.finishDate!=''">
            , finish_date = #{brtSalesOrderVo.finishDate}
        </if>
        where order_id =#{brtSalesOrderVo.orderId}
    </select>

    <select id="selectDeliveryNum" parameterType="String" resultType="String">
        SELECT
                sum(ifnull(omp.materiel_num,0))
        FROM
                brt_sales_order so
                        LEFT JOIN brt_order_materiel_plan omp ON omp.order_id = so.order_id
        where so.customer_id = #{customerId}
    </select>

    <select id="getOrderByOrderTemplateId" resultMap="BrtSalesOrderResult">
        <include refid="brtSalesOrderQuerySql"/>
        where A.order_id = (
            select order_id from brt_order_template where order_template_id = #{orderTemplateId}
        )
    </select>


</mapper>
