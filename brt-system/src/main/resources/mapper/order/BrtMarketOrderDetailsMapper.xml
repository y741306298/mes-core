<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brt.order.mapper.BrtMarketOrderDetailsMapper">

    <resultMap type="com.brt.order.vo.BrtMarketOrderDetailsVo" id="BrtMarketOrderDetailsResult">
        <result property="detailsId"    column="details_id"    />
        <result property="detailsNo"    column="details_no"    />
        <result property="orderId"    column="order_id"    />
        <result property="materielId"    column="materiel_id"    />
        <result property="materielType"    column="materiel_type"    />
        <result property="materielSize"    column="materiel_size"    />
        <result property="yieldNo"    column="yield_no"    />
        <result property="drawingNo"    column="drawing_no"    />
        <result property="supplierPn"    column="supplier_pn"    />
        <result property="detailsNum"    column="details_num"    />
        <result property="materielUnit"    column="materiel_unit"    />
        <result property="detailsPrice"    column="details_price"    />
        <result property="detailsAmount"    column="details_amount"    />
        <result property="packageModel"    column="package_model"    />
        <result property="packageTypeId"    column="package_type_id"    />
        <result property="packageSize"    column="package_size"    />
        <result property="pagkageNum"    column="pagkage_num"    />
        <result property="testTypeId"    column="test_type_id"    />
        <result property="testMode"    column="test_mode"    />
        <result property="detailsRemark"    column="details_remark"    />
        <result property="attachments"    column="attachments"    />
        <result property="boomFile"    column="boom_file"    />
        <result property="jobDrawing"    column="job_drawing"    />
        <result property="jobProgram"    column="job_program"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="materielSpec"    column="materiel_spec"    />
        <result property="coding"    column="coding"    />
        <result property="texture"    column="texture"    />
        <result property="materielNo"    column="materiel_no"    />


        <association property="materielVo" javaType="com.brt.order.vo.BrtMaterielVo" column="materiel_id" select="com.brt.order.mapper.BrtMaterielMapper.queryBrtMaterielByMaterielId" />
        <collection property="boomVoList" ofType="com.brt.order.vo.BrtOrderBoomVo" column="details_id" select="com.brt.order.mapper.BrtOrderBoomMapper.queryBrtOrderBoomByOrderDetailsId" />
    </resultMap>

    <resultMap type="com.brt.order.vo.BrtMarketOrderDetailsVo" id="statementBrtMarketOrderDetailsResult" extends="BrtMarketOrderDetailsResult">
        <result column="supplier_name" property="supplierName"/>
        <association property="marketOrderVo" javaType="com.brt.order.vo.BrtMarketOrderVo">
            <result column="order_id" property="orderId"/>
            <result column="order_no" property="orderNo"/>
            <result column="order_time" property="orderTime"/>
            <result column="total_num" property="totalNum"/>
            <result column="total_amount" property="totalAmount"/>
            <result column="template_id" property="templateId"/>
        </association>
        <association property="user" javaType="com.brt.common.core.domain.entity.SysUser" column="user_id" select="com.brt.system.mapper.SysUserMapper.selectUserById" />
    </resultMap>

    <sql id="brtMarketOrderDetailsAllField">
        A.details_id,
            A.details_no,
            A.order_id,
            A.materiel_id,
            A.materiel_type,
            A.materiel_size,
            A.yield_no,
            A.drawing_no,
            A.supplier_pn,
            A.details_num,
            A.materiel_unit,
            A.details_price,
            A.details_amount,
            A.package_model,
            A.package_type_id,
            A.package_size,
            A.pagkage_num,
            A.test_type_id,
            A.test_mode,
            A.details_remark,
            A.attachments,
            A.boom_file,
            A.job_drawing,
            A.job_program,
            A.create_time,
            A.create_by,
            A.update_time,
            A.update_by,
            A.materiel_spec,
            A.coding,
            A.texture,
            A.materiel_no
    </sql>

    <sql id="brtMarketOrderDetailsQuerySql">
        select <include refid="brtMarketOrderDetailsAllField"/>
        from brt_market_order_details A
    </sql>

    <sql id="brtMarketOrderDetailsWhereSql">
        <if test="brtMarketOrderDetailsVo.detailsNo != null  and brtMarketOrderDetailsVo.detailsNo != ''"> and A.details_no = #{brtMarketOrderDetailsVo.detailsNo}</if>
        <if test="brtMarketOrderDetailsVo.orderId != null  and brtMarketOrderDetailsVo.orderId != ''"> and A.order_id = #{brtMarketOrderDetailsVo.orderId}</if>
        <if test="brtMarketOrderDetailsVo.materielId != null  and brtMarketOrderDetailsVo.materielId != ''"> and A.materiel_id = #{brtMarketOrderDetailsVo.materielId}</if>
        <if test="brtMarketOrderDetailsVo.materielType != null  and brtMarketOrderDetailsVo.materielType != ''"> and A.materiel_type = #{brtMarketOrderDetailsVo.materielType}</if>
        <if test="brtMarketOrderDetailsVo.materielSize != null  and brtMarketOrderDetailsVo.materielSize != ''"> and A.materiel_size = #{brtMarketOrderDetailsVo.materielSize}</if>
        <if test="brtMarketOrderDetailsVo.yieldNo != null  and brtMarketOrderDetailsVo.yieldNo != ''"> and A.yield_no = #{brtMarketOrderDetailsVo.yieldNo}</if>
        <if test="brtMarketOrderDetailsVo.drawingNo != null  and brtMarketOrderDetailsVo.drawingNo != ''"> and A.drawing_no = #{brtMarketOrderDetailsVo.drawingNo}</if>
        <if test="brtMarketOrderDetailsVo.supplierPn != null  and brtMarketOrderDetailsVo.supplierPn != ''"> and A.supplier_pn = #{brtMarketOrderDetailsVo.supplierPn}</if>
        <if test="brtMarketOrderDetailsVo.detailsNum != null "> and A.details_num = #{brtMarketOrderDetailsVo.detailsNum}</if>
        <if test="brtMarketOrderDetailsVo.materielUnit != null  and brtMarketOrderDetailsVo.materielUnit != ''"> and A.materiel_unit = #{brtMarketOrderDetailsVo.materielUnit}</if>
        <if test="brtMarketOrderDetailsVo.detailsPrice != null "> and A.details_price = #{brtMarketOrderDetailsVo.detailsPrice}</if>
        <if test="brtMarketOrderDetailsVo.detailsAmount != null "> and A.details_amount = #{brtMarketOrderDetailsVo.detailsAmount}</if>
        <if test="brtMarketOrderDetailsVo.packageModel != null  and brtMarketOrderDetailsVo.packageModel != ''"> and A.package_model = #{brtMarketOrderDetailsVo.packageModel}</if>
        <if test="brtMarketOrderDetailsVo.packageTypeId != null  and brtMarketOrderDetailsVo.packageTypeId != ''"> and A.package_type_id = #{brtMarketOrderDetailsVo.packageTypeId}</if>
        <if test="brtMarketOrderDetailsVo.packageSize != null  and brtMarketOrderDetailsVo.packageSize != ''"> and A.package_size = #{brtMarketOrderDetailsVo.packageSize}</if>
        <if test="brtMarketOrderDetailsVo.pagkageNum != null "> and A.pagkage_num = #{brtMarketOrderDetailsVo.pagkageNum}</if>
        <if test="brtMarketOrderDetailsVo.testTypeId != null  and brtMarketOrderDetailsVo.testTypeId != ''"> and A.test_type_id = #{brtMarketOrderDetailsVo.testTypeId}</if>
        <if test="brtMarketOrderDetailsVo.testMode != null  and brtMarketOrderDetailsVo.testMode != ''"> and A.test_mode = #{brtMarketOrderDetailsVo.testMode}</if>
        <if test="brtMarketOrderDetailsVo.detailsRemark != null  and brtMarketOrderDetailsVo.detailsRemark != ''"> and A.details_remark = #{brtMarketOrderDetailsVo.detailsRemark}</if>
    </sql>

    <select id="queryBrtMarketOrderDetailsList" parameterType="com.brt.order.vo.BrtMarketOrderDetailsVo" resultMap="BrtMarketOrderDetailsResult">
        <include refid="brtMarketOrderDetailsQuerySql"/>
        <where>
            <include refid="brtMarketOrderDetailsWhereSql" />
        </where>
        order by A.create_time desc
    </select>

    <select id="queryBrtMarketOrderDetailsByDetailsId" resultMap="BrtMarketOrderDetailsResult">
        <include refid="brtMarketOrderDetailsQuerySql"/>
        where A.details_id = #{DetailsId}
    </select>

    <select id="statementList" resultMap="statementBrtMarketOrderDetailsResult">
        select <include refid="brtMarketOrderDetailsAllField"/>,
        o.order_no,o.order_time,o.total_num,o.total_amount,o.user_id,o.template_id,
        c.supplier_name
        from brt_market_order_details A
        inner join brt_market_order o on A.order_id = o.order_id
        left join brt_supplier c on o.supplier_id = c.supplier_id
        <where>
            <include refid="brtMarketOrderDetailsWhereSql" />
            <if test="brtMarketOrderDetailsVo.dateType != null and brtMarketOrderDetailsVo.dateType != ''">
                <choose>
                    <when test="brtMarketOrderDetailsVo.dateType == '0'.toString() ">
                        and date_format(o.order_time,'%y%m%d') = date_format(now(),'%y%m%d')
                    </when>
                    <when test="brtMarketOrderDetailsVo.dateType == '1'.toString() ">
                        and DATE(o.order_time) = CURDATE() - INTERVAL 1 DAY
                    </when>
                    <when test="brtMarketOrderDetailsVo.dateType == '2'.toString() ">
                        and date_format(o.order_time,'%y%m') = date_format(now(),'%y%m')
                    </when>
                    <when test="brtMarketOrderDetailsVo.dateType == '3'.toString() ">
                        and QUARTER(o.order_time) = QUARTER(CURDATE()) and YEAR(o.order_time) = YEAR(CURDATE())
                    </when>
                    <when test="brtMarketOrderDetailsVo.dateType == '4'.toString() ">
                        and YEAR(o.order_time) = YEAR(CURDATE())
                    </when>
                </choose>
            </if>
            <if test="brtMarketOrderDetailsVo.createTimeStart != null and brtMarketOrderDetailsVo.createTimeStart != '' and brtMarketOrderDetailsVo.createTimeEnd != null and brtMarketOrderDetailsVo.createTimeEnd != ''">
                and date_format(o.order_time,'%y%m%d') between date_format(#{brtMarketOrderDetailsVo.createTimeStart},'%y%m%d') and date_format(#{brtMarketOrderDetailsVo.createTimeEnd},'%y%m%d')
            </if>
            <if test="brtMarketOrderDetailsVo.supplierId != null and brtMarketOrderDetailsVo.supplierId != ''">
                and o.supplier_id = #{brtMarketOrderDetailsVo.supplierId}
            </if>
            <if test="brtMarketOrderDetailsVo.supplierTypeId != null and brtMarketOrderDetailsVo.supplierTypeId != ''">
                and c.supplier_type = #{brtMarketOrderDetailsVo.supplierTypeId}
            </if>
            <if test="brtMarketOrderDetailsVo.userId != null and brtMarketOrderDetailsVo.userId != ''">
                and o.user_id = #{brtMarketOrderDetailsVo.userId}
            </if>
        </where>
        order by A.create_time desc
    </select>

    <select id="getBrtMarketOrderDetailsVoListByOrderId" parameterType="String" resultMap="BrtMarketOrderDetailsResult">
        select * from brt_market_order_details where order_id = #{orderId}
    </select>

</mapper>
