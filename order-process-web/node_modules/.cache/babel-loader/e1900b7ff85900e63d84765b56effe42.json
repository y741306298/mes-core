entoryId","outInventoryId","then","res","handleAffirm","_this2","affirm","$modal","msgSuccess","toOrder","$router","push","path","salesOrder","templateId","query","_this3","listInventory","response","rows","cancel","reset","remark","createTime","createBy","updateTime","updateBy","resetForm","handleQuery","resetQuery","handleSelectionChange","selection","map","item","status","length","includes","handleAdd","handleUpdate","submitForm","_this4","validate","valid","updateInventory","addInventory","handleDelete","_this5","outInventoryIds","confirm","delInventory","catch","handleExport","download","_objectSpread2","concat","Date","getTime"],"sources":["src/views/order/outInventory/index.vue"],"sourcesContent":["<template>\n  <div class=\"app-container\">\n    <el-form :model=\"queryParams\" ref=\"queryForm\" size=\"small\" :inline=\"true\" v-show=\"showSearch\" label-width=\"68px\">\n      <el-form-item label=\"单号\" prop=\"outInventoryNo\">\n        <el-input v-model=\"queryParams.outInventoryNo\" placeholder=\"请输入入库单号\" clearable @keyup.enter.native=\"handleQuery\" />\n      </el-form-item>\n      <el-form-item label=\"状态\" prop=\"outInventoryStatus\">\n        <el-select v-model=\"queryParams.outInventoryStatus\" placeholder=\"请选择\">\n          <el-option\n            v-for=\"dict in dict.type.out_inventory_status\"\n            :key=\"dict.value\"\n            :label=\"dict.label\"\n            :value=\"dict.value\">\n          </el-option>\n        </el-select>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\n      </el-form-item>\n    </el-form>\n\n    <el-row :gutter=\"10\" class=\"mb8\">\n      <el-col :span=\"1.5\">\n        <el-button type=\"primary\" plain icon=\"el-icon-plus\" size=\"mini\" @click=\"handleAdd\" v-hasPermi=\"['order:outInventory:add']\">新增</el-button>\n      </el-col>\n      <el-col :span=\"1.5\">\n        <el-button type=\"success\" plain icon=\"el-icon-edit\" size=\"mini\" :disabled=\"single\" @click=\"handleAffirm\" v-hasPermi=\"['order:outInventory:affirm']\">确认出库</el-button>\n      </el-col>\n      <el-col :span=\"1.5\">\n        <el-button  type=\"danger\" plain icon=\"el-icon-delete\" size=\"mini\" :disabled=\"single\" @click=\"handleDelete\" v-hasPermi=\"['order:outInventory:remove']\">删除</el-button>\n      </el-col>\n      <el-col :span=\"1.5\">\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\n      </el-col>\n      <el-col :span=\"1.5\">\n        <el-button type=\"info\" plain icon=\"el-icon-delete\" size=\"mini\" :disabled=\"single1\" @click=\"handlePrint\">打印物料出库单</el-button>\n      </el-col>\n      <right-toolbar :columns=\"columnList\" :cacheKey=\"cacheKey\" :showSearch.sync=\"showSearch\" @queryTable=\"getList\"></right-toolbar>\n    </el-row>\n\n    <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"inventoryList\" @selection-change=\"handleSelectionChange\">\n      <el-table-column label=\"序号\" type=\"index\" width=\"50\" align=\"center\" />\n      <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\n      <!-- 循环字段 -->\n      <template v-for=\"(item,index) in cacheCloumnList\">\n        <el-table-column v-if=\"item.visible\" :label=\"item.label\" :prop=\"item.prop\" :width=\"item.width||''\"\n          :align=\"item.align||'center'\">\n          <template slot-scope=\"scope\">\n            <!-- 字典 -->\n            <dict-tag v-if=\"item.type == 'dict'\" :options=\"dict.type[item.dictType]\" :value=\"scope.row[item.prop]\" />\n            <dict-tag v-else-if=\"item.type == 'objDict'\" :options=\"dict.type[item.dictType]\"\n              :value=\"getObjAttr(scope.row, item.prop)\" />\n            <!-- 日期 -->\n            <span v-else-if=\"item.type == 'date'\">{{ parseTime(scope.row[item.prop], item.dateFormat) }}</span>\n            <!-- 图片 -->\n            <image-preview v-else-if=\"item.type == 'img'\" :src=\"scope.row[item.prop]\" :width=\"50\" :height=\"50\"/>\n            <!-- 多层对象 -->\n            <span v-else-if=\"item.type == 'obj'\">{{ getObjAttr(scope.row, item.prop) }}</span>\n            <!-- 其他 -->\n            <template v-else-if=\"item.type == 'other'\">\n              <el-button type=\"text\" v-if=\"item.prop == 'materielInfo'\" @click=\"checkMaterielInfo(scope.row)\">查看</el-button>\n              <el-button type=\"text\" v-if=\"item.prop == 'outInventoryNo'\" @click=\"handleUpdate(scope.row)\">{{scope.row[item.prop]}}</el-button>\n              <el-button type=\"text\" v-if=\"item.prop == 'orderNo' && scope.row.salesOrder!=null\" @click=\"toOrder(scope.row)\">{{scope.row.salesOrder.orderNo}}</el-button>\n            </template>\n            <span v-else>{{scope.row[item.prop]}}</span>\n          </template>\n        </el-table-column>\n      </template>\n    </el-table>\n    <pagination v-show=\"total>0\" :total=\"total\" :page.sync=\"queryParams.pageNum\" :limit.sync=\"queryParams.pageSize\" @pagination=\"getList\" />\n\n    <el-dialog :title=\"checkMateriel.title\" :visible.sync=\"checkMateriel.open\">\n      <el-table :data=\"checkMaterielList\">\n        <el-table-column label=\"序号\" type=\"index\" width=\"50\" align=\"center\" />\n        <el-table-column property=\"materielName\" label=\"名称\"></el-table-column>\n        <el-table-column property=\"materielNo\" label=\"编号\"></el-table-column>\n        <el-table-column property=\"outInventoryNum\" label=\"数量\"></el-table-column>\n        <el-table-column property=\"remark\" label=\"备注\"></el-table-column>\n      </el-table>\n    </el-dialog>\n\n    <outinventoryprint ref=\"outinventoryprint\"></outinventoryprint>\n\n  </div>\n\n</template>\n\n<script>\nimport {\n  listInventory,\n  listInventoryAll,\n  getInventory,\n  delInventory,\n  addInventory,\n  updateInventory,\n  affirm\n} from \"@/api/order/outInventory\";\n\nimport {\n  queryByOutInventoryId\n} from \"@/api/order/outInventoryMateriel\";\n\nimport outinventoryprint from \"@/views/order/outInventory/print.vue\";\n\nexport default {\n  name: \"OutInventoryIndex\",\n  dicts: [\"out_inventory_type\",\"out_inventory_status\"],\n  components:{\n    outinventoryprint\n  },\n  watch: {\n    '$route': {\n      handler: function(to,form){\n        this.onLoad();\n      },\n      immediate: true\n    }\n  },\n  data() {\n    return {\n      //弹出层\n      checkMateriel:{\n        //弹出层显示隐藏\n        open: false,\n        // 标题\n        title: \"\",\n      },\n      //弹出层表格数据\n      checkMaterielList: [],\n      // 遮罩层\n      loading: true,\n      // 选中数组\n      ids: [],\n      // 非单个禁用\n      single: true,\n      //打印\n      single1: true,\n      // 非多个禁用\n      multiple: true,\n      // 显示搜索条件\n      showSearch: true,\n      // 总条数\n      total: 0,\n      // 出库管理表格数据\n      inventoryList: [],\n      // 弹出层标题\n      title: \"\",\n      // 查询参数\n      queryParams: {\n        pageNum: 1,\n        pageSize: 10,\n        orderId: null,\n        outInventoryNo: null,\n        outInventoryType: null,\n        outInventoryStatus: null,\n        applicat: null,\n        applyTime: null,\n        createTo: null,\n        updateTo: null\n      },\n      // 表单参数\n      form: {},\n      // 表单校验\n      rules: {\n      },\n      cacheCloumnList: [], //缓存字段列表\n      //缓存名称\n      cacheKey: \"Inventory\",\n      columnList:[\n      {\n        label: \"单号\",\n        prop: \"outInventoryNo\",\n        visible: true,\n        align: \"center\",\n        type: \"other\"\n      },\n      {\n        label: \"出库类型\",\n        prop: \"outInventoryType\",\n        visible: true,\n        align: \"center\",\n        type: \"dict\",\n        dictType: \"out_inventory_type\"\n      },\n      {\n        label: \"产品信息\",\n        prop: \"materielInfo\",\n        visible: true,\n        align: \"center\",\n        type: \"other\"\n\n      },\n      {\n        label: \"关联单号\",\n        prop: \"orderNo\",\n        visible: true,\n        align: \"center\",\n        type: \"other\"\n\n      },\n      {\n        label: \"出库状态\",\n        prop: \"outInventoryStatus\",\n        visible: true,\n        align: \"center\",\n        type: \"dict\",\n        dictType: \"out_inventory_status\"\n      },\n      {\n        label: \"申请人\",\n        prop: \"user.nickName\",\n        visible: true,\n        align: \"center\",\n        type: \"obj\"\n      },\n      {\n        label: \"申请时间\",\n        prop: \"applyTime\",\n        visible: true,\n        align: \"center\",\n        type: \"date\",\n        dateFormat: \"{y}-{m}-{d}\"\n      },\n      {\n        label: \"备注\",\n        prop: \"remark\",\n        visible: true,\n        align: \"center\",\n      }\n      ]\n    };\n  },\n  created() {\n    this.onLoad();\n  },\n  methods: {\n\n    handlePrint(){\n      this.$refs.outinventoryprint.OnClick(this.ids[0])\n    },\n\n    onLoad(){\n      this.getList();\n      this.refreshCloumn(this);\n    },\n    /**\n     * 表格中查看产品信息\n     */\n    checkMaterielInfo(row){\n      queryByOutInventoryId(row.outInventoryId).then(res=>{\n        this.checkMaterielList = res.data;\n        this.checkMateriel.open = true;\n        this.checkMateriel.title = \"产品信息（\"+row.outInventoryNo+\")\"\n      })\n\n    },\n    /**\n     * 确认出库\n     */\n    handleAffirm(){\n      affirm(this.ids[0]).then(res=>{\n        this.$modal.msgSuccess(\"操作成功\");\n        this.getList();\n      })\n    },\n    // 跳转到采购单\n    toOrder(row){\n      this.$router.push({\n        path: '/salesOrder/info/index/'+row.salesOrder.templateId,\n        query: {\n          orderId: row.salesOrder.orderId\n        }\n      });\n    },\n    /** 查询出库管理列表 */\n    getList() {\n      this.loading = true;\n      listInventory(this.queryParams).then(response => {\n        this.inventoryList = response.rows;\n        this.total = response.total;\n        this.loading = false;\n      });\n    },\n    // 取消按钮\n    cancel() {\n      this.open = false;\n      this.reset();\n    },\n    // 表单重置\n    reset() {\n      this.form = {\n        outInventoryId: null,\n        orderId: null,\n        outInventoryNo: null,\n        outInventoryType: null,\n        outInventoryStatus: null,\n        applicat: null,\n        applyTime: null,\n        remark: null,\n        createTime: null,\n        createBy: null,\n        updateTime: null,\n        updateBy: null\n      };\n      this.resetForm(\"form\");\n    },\n    /** 搜索按钮操作 */\n    handleQuery() {\n      this.queryParams.pageNum = 1;\n      this.getList();\n    },\n    /** 重置按钮操作 */\n    resetQuery() {\n      this.resetForm(\"queryForm\");\n      this.handleQuery();\n    },\n    // 多选框选中数据\n    handleSelectionChange(selection) {\n      this.ids = selection.map(item => item.outInventoryId)\n      let status = selection.map(item => item.outInventoryStatus);\n      this.single = selection.length!==1 || status.includes(\"1\");\n      this.single1 = selection.length!==1;\n      this.multiple = !selection.length\n    },\n    /** 新增按钮操作 */\n    handleAdd() {\n      this.$router.push({\n        path: '/outInventory/add/index'\n      });\n    },\n    /** 修改按钮操作 */\n    handleUpdate(row) {\n      this.$router.push({\n        path: '/outInventory/add/index',\n        query: {\n          outInventoryId: row.outInventoryId\n        }\n      });\n    },\n    /** 提交按钮 */\n    submitForm() {\n      this.$refs[\"form\"].validate(valid => {\n        if (valid) {\n          if (this.form.outInventoryId != null) {\n            updateInventory(this.form).then(response => {\n              this.$modal.msgSuccess(\"修改成功\");\n              this.open = false;\n              this.getList();\n            });\n          } else {\n            addInventory(this.form).then(response => {\n              this.$modal.msgSuccess(\"新增成功\");\n              this.open = false;\n              this.getList();\n            });\n          }\n        }\n      });\n    },\n    /** 删除按钮操作 */\n    handleDelete(row) {\n      const outInventoryIds = row.outInventoryId || this.ids;\n      this.$modal.confirm('确认删除？').then(function() {\n        return delInventory(outInventoryIds);\n      }).then(() => {\n        this.getList();\n        this.$modal.msgSuccess(\"删除成功\");\n      }).catch(() => {});\n    },\n    /** 导出按钮操作 */\n    handleExport() {\n      this.download('order/inventory/export', {\n        ...this.queryParams\n      }, `inventory_${new Date().getTime()}.xlsx`)\n    }\n  }\n};\n</script>\n"],"mappings":";;;;;;;;;;;;;;;AAyFA,IAAAA,aAAA,GAAAC,OAAA;AAUA,IAAAC,qBAAA,GAAAD,OAAA;AAIA,IAAAE,MAAA,GAAAC,sBAAA,CAAAH,OAAA;AAAA,IAAAI,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,KAAA;EACAC,UAAA;IACAC,iBAAA,EAAAA;EACA;EACAC,KAAA;IACA;MACAC,OAAA,WAAAA,QAAAC,EAAA,EAAAC,IAAA;QACA,KAAAC,MAAA;MACA;MACAC,SAAA;IACA;EACA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,aAAA;QACA;QACAC,IAAA;QACA;QACAC,KAAA;MACA;MACA;MACAC,iBAAA;MACA;MACAC,OAAA;MACA;MACAC,GAAA;MACA;MACAC,MAAA;MACA;MACAC,OAAA;MACA;MACAC,QAAA;MACA;MACAC,UAAA;MACA;MACAC,KAAA;MACA;MACAC,aAAA;MACA;MACAT,KAAA;MACA;MACAU,WAAA;QACAC,OAAA;QACAC,QAAA;QACAC,OAAA;QACAC,cAAA;QACAC,gBAAA;QACAC,kBAAA;QACAC,QAAA;QACAC,SAAA;QACAC,QAAA;QACAC,QAAA;MACA;MACA;MACA1B,IAAA;MACA;MACA2B,KAAA,GACA;MACAC,eAAA;MAAA;MACA;MACAC,QAAA;MACAC,UAAA,GACA;QACAC,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;MACA,GACA;QACAJ,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;QACAC,QAAA;MACA,GACA;QACAL,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;MAEA,GACA;QACAJ,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;MAEA,GACA;QACAJ,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;QACAC,QAAA;MACA,GACA;QACAL,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;MACA,GACA;QACAJ,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;QACAE,UAAA;MACA,GACA;QACAN,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA;IAEA;EACA;EACAI,OAAA,WAAAA,QAAA;IACA,KAAArC,MAAA;EACA;EACAsC,OAAA;IAEAC,WAAA,WAAAA,YAAA;MACA,KAAAC,KA