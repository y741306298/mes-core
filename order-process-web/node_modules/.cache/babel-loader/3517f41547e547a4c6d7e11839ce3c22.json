pend-to-body>\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" label-width=\"0px\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"12\">\n            <el-form-item label=\"\" prop=\"typeName\">\n              <el-input v-model=\"form.typeName\" placeholder=\"请输入类型名称\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"2\">\n            <el-button type=\"primary\" @click=\"submitForm\">新 增</el-button>\n          </el-col>\n        </el-row>\n        <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"customerTypeList\">\n          <el-table-column label=\"客户类型\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-input v-if=\"scope.row.isEdit\" v-model=\"scope.row.typeName\" placeholder=\"请输入客户类型\" />\n              <span v-else>{{scope.row.typeName}}</span>\n            </template>\n          </el-table-column>\n          <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\n            <template slot-scope=\"scope\">\n              <template v-if=\"scope.row.isEdit\">\n                <el-button size=\"mini\" type=\"text\" @click=\"handleEditSubmit(scope.row)\">保存</el-button>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleCancel()\">取消</el-button>\n              </template>\n              <template v-else>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleUpdate(scope.row)\"\n                  v-hasPermi=\"['order:customerType:edit']\">修改</el-button>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleDelete(scope.row)\"\n                  v-hasPermi=\"['order:customerType:remove']\">删除</el-button>\n              </template>\n            </template>\n          </el-table-column>\n        </el-table>\n      </el-form>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\n  import {\n    listCustomerType,\n    listCustomerTypeAll,\n    getCustomerType,\n    delCustomerType,\n    addCustomerType,\n    updateCustomerType\n  } from \"@/api/order/customerType\";\n\n  export default {\n    name: \"CustomerType\",\n    data() {\n      return {\n        // 遮罩层\n        loading: true,\n        // 客户类型管理表格数据\n        customerTypeList: [],\n        // 弹出层标题\n        title: \"\",\n        // 是否显示弹出层\n        open: false,\n        // 表单参数\n        form: {},\n        // 表单校验\n        rules: {}\n      };\n    },\n    methods: {\n      /**\n       * 修改保存\n       */\n      handleEditSubmit(row) {\n        updateCustomerType(row).then(response => {\n          this.$modal.msgSuccess(\"修改成功\");\n          this.getList();\n          this.$emit('getList')\n        });\n      },\n      /**\n       * 取消编辑\n       */\n      handleCancel() {\n        this.getList();\n      },\n      /**\n       * 打开弹框\n       */\n      handleOpen() {\n        this.getList();\n        this.reset();\n        this.open = true;\n        this.title = \"客户类型\"\n      },\n      /** 查询客户类型管理列表 */\n      getList() {\n        this.loading = true;\n        listCustomerTypeAll().then(response => {\n          this.customerTypeList = response.data;\n          this.loading = false;\n        });\n      },\n      // 取消按钮\n      cancel() {\n        this.open = false;\n        this.reset();\n      },\n      // 表单重置\n      reset() {\n        this.form = {\n          typeId: null,\n          typeName: null,\n          createTime: null,\n          createBy: null,\n          updateTime: null,\n          updateBy: null\n        };\n        this.resetForm(\"form\");\n      },\n      /** 修改按钮操作 */\n      handleUpdate(row) {\n        this.$set(row, 'isEdit', true)\n      },\n      /** 提交按钮 */\n      submitForm() {\n        addCustomerType(this.form).then(response => {\n          this.$modal.msgSuccess(\"新增成功\");\n          this.getList();\n          this.$emit('getList')\n        });\n      },\n      /** 删除按钮操作 */\n      handleDelete(row) {\n        const typeIds = row.typeId || this.ids;\n        this.$modal.confirm('确认删除？').then(function() {\n          return delCustomerType(typeIds);\n        }).then(() => {\n          this.getList();\n          this.$emit('getList')\n          this.$modal.msgSuccess(\"删除成功\");\n        }).catch(() => {});\n      }\n    }\n  };\n</script>\n"],"mappings":";;;;;;AA2CA,IAAAA,aAAA,GAAAC,OAAA;AAOA,IAAAC,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,OAAA;MACA;MACAC,gBAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;IACA;EACA;EACAC,OAAA;IACA;AACA;AACA;IACAC,gBAAA,WAAAA,iBAAAC,GAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,gCAAA,EAAAF,GAAA,EAAAG,IAAA,WAAAC,QAAA;QACAH,KAAA,CAAAI,MAAA,CAAAC,UAAA;QACAL,KAAA,CAAAM,OAAA;QACAN,KAAA,CAAAO,KAAA;MACA;IACA;IACA;AACA;AACA;IACAC,YAAA,WAAAA,aAAA;MACA,KAAAF,OAAA;IACA;IACA;AACA;AACA;IACAG,UAAA,WAAAA,WAAA;MACA,KAAAH,OAAA;MACA,KAAAI,KAAA;MACA,KAAAhB,IAAA;MACA,KAAAD,KAAA;IACA;IACA,iBACAa,OAAA,WAAAA,QAAA;MAAA,IAAAK,MAAA;MACA,KAAApB,OAAA;MACA,IAAAqB,iCAAA,IAAAV,IAAA,WAAAC,QAAA;QACAQ,MAAA,CAAAnB,gBAAA,GAAAW,QAAA,CAAAb,IAAA;QACAqB,MAAA,CAAApB,OAAA;MACA;IACA;IACA;IACAsB,MAAA,WAAAA,OAAA;MACA,KAAAnB,IAAA;MACA,KAAAgB,KAAA;IACA;IACA;IACAA,KAAA,WAAAA,MAAA;MACA,KAAAf,IAAA;QACAmB,MAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACA,KAAAC,SAAA;IACA;IACA,aACAC,YAAA,WAAAA,aAAAtB,GAAA;MACA,KAAAuB,IAAA,CAAAvB,GAAA;IACA;IACA,WACAwB,UAAA,WAAAA,WAAA;MAAA,IAAAC,MAAA;MACA,IAAAC,6BAAA,OAAA9B,IAAA,EAAAO,IAAA,WAAAC,QAAA;QACAqB,MAAA,CAAApB,MAAA,CAAAC,UAAA;QACAmB,MAAA,CAAAlB,OAAA;QACAkB,MAAA,CAAAjB,KAAA;MACA;IACA;IACA,aACAmB,YAAA,WAAAA,aAAA3B,GAAA;MAAA,IAAA4B,MAAA;MACA,IAAAC,OAAA,GAAA7B,GAAA,CAAAe,MAAA,SAAAe,GAAA;MACA,KAAAzB,MAAA,CAAA0B,OAAA,UAAA5B,IAAA;QACA,WAAA6B,6BAAA,EAAAH,OAAA;MACA,GAAA1B,IAAA;QACAyB,MAAA,CAAArB,OAAA;QACAqB,MAAA,CAAApB,KAAA;QACAoB,MAAA,CAAAvB,MAAA,CAAAC,UAAA;MACA,GAAA2B,KAAA;IACA;EACA;AACA","ignoreList":[]}]}