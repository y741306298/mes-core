      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" label-width=\"0px\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"12\">\n            <el-form-item label=\"\" prop=\"typeName\">\n              <el-input v-model=\"form.typeName\" placeholder=\"请输入类型名称\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"2\">\n            <el-button type=\"primary\" @click=\"submitForm\">新 增</el-button>\n          </el-col>\n        </el-row>\n        <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"materielTypeList\">\n          <el-table-column label=\"物料类型\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-input v-if=\"scope.row.isEdit\" v-model=\"scope.row.typeName\" placeholder=\"请输入客户类型\" />\n              <span v-else>{{scope.row.typeName}}</span>\n            </template>\n          </el-table-column>\n          <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\n            <template slot-scope=\"scope\">\n              <template v-if=\"scope.row.isEdit\">\n                <el-button size=\"mini\" type=\"text\" @click=\"handleEditSubmit(scope.row)\">保存</el-button>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleCancel()\">取消</el-button>\n              </template>\n              <template v-else>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleUpdate(scope.row)\"\n                  v-hasPermi=\"['order:materielType:edit']\">修改</el-button>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleDelete(scope.row)\"\n                  v-hasPermi=\"['order:materielType:remove']\">删除</el-button>\n              </template>\n            </template>\n          </el-table-column>\n        </el-table>\n      </el-form>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\n  import {\n    listMaterielType,\n    listMaterielTypeAll,\n    getMaterielType,\n    delMaterielType,\n    addMaterielType,\n    updateMaterielType\n  } from \"@/api/order/materielType\";\n\n  export default {\n    name: \"MaterielType\",\n    data() {\n      return {\n        // 遮罩层\n        loading: true,\n        // 物料类型表格数据\n        materielTypeList: [],\n        // 弹出层标题\n        title: \"\",\n        // 是否显示弹出层\n        open: false,\n        // 表单参数\n        form: {},\n        // 表单校验\n        rules: {},\n      };\n    },\n    methods: {\n      /**\n       * 修改保存\n       */\n      handleEditSubmit(row) {\n        updateMaterielType(row).then(response => {\n          this.$modal.msgSuccess(\"修改成功\");\n          this.getList();\n          this.$emit('getList');\n        });\n      },\n      /**\n       * 取消编辑\n       */\n      handleCancel() {\n        this.getList();\n      },\n      /**\n       * 打开弹框\n       */\n      handleOpen() {\n        this.getList();\n        this.reset();\n        this.open = true;\n        this.title = \"物料类型\"\n      },\n      /** 查询物料类型列表 */\n      getList() {\n        this.loading = true;\n        listMaterielTypeAll().then(response => {\n          this.materielTypeList = response.data;\n          this.loading = false;\n        });\n      },\n      // 取消按钮\n      cancel() {\n        this.open = false;\n        this.reset();\n      },\n      // 表单重置\n      reset() {\n        this.form = {\n          typeId: null,\n          typeName: null,\n          createTime: null,\n          createBy: null,\n          updateTime: null,\n          updateBy: null\n        };\n        this.resetForm(\"form\");\n      },\n      /** 新增按钮操作 */\n      handleAdd() {\n        this.reset();\n        this.open = true;\n        this.title = \"添加物料类型\";\n      },\n      /** 修改按钮操作 */\n      handleUpdate(row) {\n        this.$set(row, 'isEdit', true)\n      },\n      /** 提交按钮 */\n      submitForm() {\n        addMaterielType(this.form).then(response => {\n          this.$modal.msgSuccess(\"新增成功\");\n          this.getList();\n          this.$emit('getList');\n        });\n      },\n      /** 删除按钮操作 */\n      handleDelete(row) {\n        const typeIds = row.typeId || this.ids;\n        this.$modal.confirm('确认删除？').then(function() {\n          return delMaterielType(typeIds);\n        }).then(() => {\n          this.getList();\n          this.$emit('getList');\n          this.$modal.msgSuccess(\"删除成功\");\n        }).catch(() => {});\n      },\n    }\n  };\n</script>\n"],"mappings":";;;;;;AA4CA,IAAAA,aAAA,GAAAC,OAAA;AAOA,IAAAC,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,OAAA;MACA;MACAC,gBAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;IACA;EACA;EACAC,OAAA;IACA;AACA;AACA;IACAC,gBAAA,WAAAA,iBAAAC,GAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,gCAAA,EAAAF,GAAA,EAAAG,IAAA,WAAAC,QAAA;QACAH,KAAA,CAAAI,MAAA,CAAAC,UAAA;QACAL,KAAA,CAAAM,OAAA;QACAN,KAAA,CAAAO,KAAA;MACA;IACA;IACA;AACA;AACA;IACAC,YAAA,WAAAA,aAAA;MACA,KAAAF,OAAA;IACA;IACA;AACA;AACA;IACAG,UAAA,WAAAA,WAAA;MACA,KAAAH,OAAA;MACA,KAAAI,KAAA;MACA,KAAAhB,IAAA;MACA,KAAAD,KAAA;IACA;IACA,eACAa,OAAA,WAAAA,QAAA;MAAA,IAAAK,MAAA;MACA,KAAApB,OAAA;MACA,IAAAqB,iCAAA,IAAAV,IAAA,WAAAC,QAAA;QACAQ,MAAA,CAAAnB,gBAAA,GAAAW,QAAA,CAAAb,IAAA;QACAqB,MAAA,CAAApB,OAAA;MACA;IACA;IACA;IACAsB,MAAA,WAAAA,OAAA;MACA,KAAAnB,IAAA;MACA,KAAAgB,KAAA;IACA;IACA;IACAA,KAAA,WAAAA,MAAA;MACA,KAAAf,IAAA;QACAmB,MAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACA,KAAAC,SAAA;IACA;IACA,aACAC,SAAA,WAAAA,UAAA;MACA,KAAAX,KAAA;MACA,KAAAhB,IAAA;MACA,KAAAD,KAAA;IACA;IACA,aACA6B,YAAA,WAAAA,aAAAvB,GAAA;MACA,KAAAwB,IAAA,CAAAxB,GAAA;IACA;IACA,WACAyB,UAAA,WAAAA,WAAA;MAAA,IAAAC,MAAA;MACA,IAAAC,6BAAA,OAAA/B,IAAA,EAAAO,IAAA,WAAAC,QAAA;QACAsB,MAAA,CAAArB,MAAA,CAAAC,UAAA;QACAoB,MAAA,CAAAnB,OAAA;QACAmB,MAAA,CAAAlB,KAAA;MACA;IACA;IACA,aACAoB,YAAA,WAAAA,aAAA5B,GAAA;MAAA,IAAA6B,MAAA;MACA,IAAAC,OAAA,GAAA9B,GAAA,CAAAe,MAAA,SAAAgB,GAAA;MACA,KAAA1B,MAAA,CAAA2B,OAAA,UAAA7B,IAAA;QACA,WAAA8B,6BAAA,EAAAH,OAAA;MACA,GAAA3B,IAAA;QACA0B,MAAA,CAAAtB,OAAA;QACAsB,MAAA,CAAArB,KAAA;QACAqB,MAAA,CAAAxB,MAAA,CA