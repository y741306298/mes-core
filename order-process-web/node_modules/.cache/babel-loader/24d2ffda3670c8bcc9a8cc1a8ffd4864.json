m\" :rules=\"rules\" label-width=\"0px\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"12\">\n            <el-form-item label=\"\" prop=\"modeName\">\n              <el-input v-model=\"form.modeName\" placeholder=\"请输入测试方式\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"2\">\n            <el-button type=\"primary\" @click=\"submitForm\">新 增</el-button>\n          </el-col>\n        </el-row>\n        <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"testModeList\">\n          <el-table-column label=\"测试方式\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-input v-if=\"scope.row.isEdit\" v-model=\"scope.row.modeName\" placeholder=\"请输入测试方式\" />\n              <span v-else>{{scope.row.modeName}}</span>\n            </template>\n          </el-table-column>\n          <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\n            <template slot-scope=\"scope\">\n              <template v-if=\"scope.row.isEdit\">\n                <el-button size=\"mini\" type=\"text\" @click=\"handleEditSubmit(scope.row)\">保存</el-button>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleCancel()\">取消</el-button>\n              </template>\n              <template v-else>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleUpdate(scope.row)\"\n                  v-hasPermi=\"['order:customerType:edit']\">修改</el-button>\n                <el-button size=\"mini\" type=\"text\" @click=\"handleDelete(scope.row)\"\n                  v-hasPermi=\"['order:customerType:remove']\">删除</el-button>\n              </template>\n            </template>\n          </el-table-column>\n        </el-table>\n      </el-form>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\n  import {\n    listTestMode,\n    listTestModeAll,\n    getTestMode,\n    delTestMode,\n    addTestMode,\n    updateTestMode\n  } from \"@/api/order/testMode\";\n\n  export default {\n    name: \"TestMode\",\n    data() {\n      return {\n        // 遮罩层\n        loading: true,\n        // 测试方式管理表格数据\n        testModeList: [],\n        // 弹出层标题\n        title: \"\",\n        // 是否显示弹出层\n        open: false,\n        // 表单参数\n        form: {},\n        // 表单校验\n        rules: {}\n      };\n    },\n    created() {\n    },\n    methods: {\n      /**\n       * 修改保存\n       */\n      handleEditSubmit(row) {\n        updateTestMode(row).then(response => {\n          this.$modal.msgSuccess(\"修改成功\");\n          this.getList();\n          this.$emit('getList');\n        });\n      },\n      /**\n       * 取消编辑\n       */\n      handleCancel() {\n        this.getList();\n      },\n      /**\n       * 打开弹框\n       */\n      handleOpen() {\n        this.getList();\n        this.reset();\n        this.open = true;\n        this.title = \"测试方式\"\n      },\n      /** 查询测试方式管理列表 */\n      getList() {\n        this.loading = true;\n        listTestModeAll().then(response => {\n          this.testModeList = response.data;\n          this.loading = false;\n        });\n      },\n      // 取消按钮\n      cancel() {\n        this.open = false;\n        this.reset();\n      },\n      // 表单重置\n      reset() {\n        this.form = {\n          modeId: null,\n          modeName: null,\n          createTime: null,\n          createBy: null,\n          updateTime: null,\n          updateBy: null\n        };\n        this.resetForm(\"form\");\n      },\n      /** 修改按钮操作 */\n      handleUpdate(row) {\n        this.$set(row, 'isEdit', true);\n      },\n      /** 提交按钮 */\n      submitForm() {\n        addTestMode(this.form).then(response => {\n          this.$modal.msgSuccess(\"新增成功\");\n          this.getList();\n          this.$emit('getList');\n        });\n      },\n      /** 删除按钮操作 */\n      handleDelete(row) {\n        const modeIds = row.modeId || this.ids;\n        this.$modal.confirm('确认删除？').then(function() {\n          return delTestMode(modeIds);\n        }).then(() => {\n          this.getList();\n          this.$emit('getList');\n          this.$modal.msgSuccess(\"删除成功\");\n        }).catch(() => {});\n      },\n    }\n  };\n</script>\n"],"mappings":";;;;;;AA0CA,IAAAA,SAAA,GAAAC,OAAA;AAOA,IAAAC,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,OAAA;MACA;MACAC,YAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA,GACA;EACAC,OAAA;IACA;AACA;AACA;IACAC,gBAAA,WAAAA,iBAAAC,GAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,wBAAA,EAAAF,GAAA,EAAAG,IAAA,WAAAC,QAAA;QACAH,KAAA,CAAAI,MAAA,CAAAC,UAAA;QACAL,KAAA,CAAAM,OAAA;QACAN,KAAA,CAAAO,KAAA;MACA;IACA;IACA;AACA;AACA;IACAC,YAAA,WAAAA,aAAA;MACA,KAAAF,OAAA;IACA;IACA;AACA;AACA;IACAG,UAAA,WAAAA,WAAA;MACA,KAAAH,OAAA;MACA,KAAAI,KAAA;MACA,KAAAjB,IAAA;MACA,KAAAD,KAAA;IACA;IACA,iBACAc,OAAA,WAAAA,QAAA;MAAA,IAAAK,MAAA;MACA,KAAArB,OAAA;MACA,IAAAsB,yBAAA,IAAAV,IAAA,WAAAC,QAAA;QACAQ,MAAA,CAAApB,YAAA,GAAAY,QAAA,CAAAd,IAAA;QACAsB,MAAA,CAAArB,OAAA;MACA;IACA;IACA;IACAuB,MAAA,WAAAA,OAAA;MACA,KAAApB,IAAA;MACA,KAAAiB,KAAA;IACA;IACA;IACAA,KAAA,WAAAA,MAAA;MACA,KAAAhB,IAAA;QACAoB,MAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACA,KAAAC,SAAA;IACA;IACA,aACAC,YAAA,WAAAA,aAAAtB,GAAA;MACA,KAAAuB,IAAA,CAAAvB,GAAA;IACA;IACA,WACAwB,UAAA,WAAAA,WAAA;MAAA,IAAAC,MAAA;MACA,IAAAC,qBAAA,OAAA/B,IAAA,EAAAQ,IAAA,WAAAC,QAAA;QACAqB,MAAA,CAAApB,MAAA,CAAAC,UAAA;QACAmB,MAAA,CAAAlB,OAAA;QACAkB,MAAA,CAAAjB,KAAA;MACA;IACA;IACA,aACAmB,YAAA,WAAAA,aAAA3B,GAAA;MAAA,IAAA4B,MAAA;MACA,IAAAC,OAAA,GAAA7B,GAAA,CAAAe,MAAA,SAAAe,GAAA;MACA,KAAAzB,MAAA,CAAA0B,OAAA,UAAA5B,IAAA;QACA,WAAA6B,qBAAA,EAAAH,OAAA;MACA,GAAA1B,IAAA;QACAyB,MAAA,CAAArB,OAAA;QACAqB,MAAA,CAAApB,KAAA;QACAoB,MAAA,CAAAvB,MAAA,CAAAC,UAAA;MACA,GAAA2B,KAAA;IACA;EACA;AACA","ignoreList":[]}]}