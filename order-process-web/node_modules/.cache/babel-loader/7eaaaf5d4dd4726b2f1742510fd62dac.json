n      <el-form-item label=\"\" prop=\"\">\n        <el-date-picker v-model=\"queryParams.createTimes\" value-format=\"yyyy-MM-dd\" type=\"daterange\" range-separator=\"至\"\n          start-placeholder=\"开始日期\" end-placeholder=\"结束日期\">\n        </el-date-picker>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\n      </el-form-item>\n    </el-form>\n\n    <el-row :gutter=\"10\" class=\"mb8\">\n      <el-col :span=\"1.5\">\n        <el-button type=\"primary\" plain icon=\"el-icon-plus\" size=\"mini\" @click=\"handleAdd\">新增销售单</el-button>\n      </el-col>\n      <el-col :span=\"1.5\">\n        <el-button type=\"success\" plain icon=\"el-icon-truck\" size=\"mini\"\n          @click=\"handleDelivery\">送货</el-button>\n      </el-col>\n      <right-toolbar :columns=\"columnList\" :cacheKey=\"cacheKey\" :showSearch.sync=\"showSearch\"\n        @queryTable=\"getList\"></right-toolbar>\n    </el-row>\n\n    <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"customerDeliveryList\"\n      @selection-change=\"handleSelectionChange\">\n      <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\n      <!-- 循环字段 -->\n      <template v-for=\"(item,index) in cacheCloumnList\">\n        <el-table-column v-if=\"item.visible\" :label=\"item.label\" :prop=\"item.prop\" :width=\"item.width||''\"\n          :align=\"item.align||'center'\">\n          <template slot-scope=\"scope\">\n            <!-- 字典 -->\n            <dict-tag v-if=\"item.type == 'dict'\" :options=\"dict.type[item.dictType]\" :value=\"scope.row[item.prop]\" />\n            <dict-tag v-else-if=\"item.type == 'objDict'\" :options=\"dict.type[item.dictType]\"\n              :value=\"getObjAttr(scope.row, item.prop)\" />\n            <!-- 日期 -->\n            <span v-else-if=\"item.type == 'date'\">{{ parseTime(scope.row[item.prop], item.dateFormat) }}</span>\n            <!-- 图片 -->\n            <image-preview v-else-if=\"item.type == 'img'\" :src=\"scope.row[item.prop]\" :width=\"50\" :height=\"50\" />\n            <!-- 多层对象 -->\n            <span v-else-if=\"item.type == 'obj'\">{{ getObjAttr(scope.row, item.prop) }}</span>\n            <!-- 其他 -->\n            <template v-else-if=\"item.type == 'other'\">\n            </template>\n            <span v-else>{{scope.row[item.prop]}}</span>\n          </template>\n        </el-table-column>\n      </template>\n\n    </el-table>\n\n    <pagination v-show=\"total>0\" :total=\"total\" :page.sync=\"queryParams.pageNum\" :limit.sync=\"queryParams.pageSize\"\n      @pagination=\"getList\" />\n\n\n  </div>\n</template>\n\n<script>\n  import {\n    listCustomerDelivery,\n    listCustomerDeliveryAll,\n    getCustomerDelivery,\n    delCustomerDelivery,\n    addCustomerDelivery,\n    updateCustomerDelivery\n  } from \"@/api/order/customerDelivery\";\n\n  import {\n    queryMarketRecord\n  } from \"@/api/order/customer\";\n\n  export default {\n    name: \"CustomerDelivery\",\n    dicts: ['delivery_status', 'collection_status'],\n    data() {\n      return {\n        // 遮罩层\n        loading: true,\n        // 选中数组\n        ids: [],\n        // 非单个禁用\n        single: true,\n        // 非多个禁用\n        multiple: true,\n        // 显示搜索条件\n        showSearch: true,\n        // 总条数\n        total: 0,\n        // 客户送货单表格数据\n        customerDeliveryList: [],\n        // 弹出层标题\n        title: \"\",\n        // 是否显示弹出层\n        open: false,\n        // 查询参数\n        queryParams: {\n          pageNum: 1,\n          pageSize: 10,\n          customerId: null,\n          orderId: null,\n          orderNodeId: null,\n          collectionStatus: null,\n          deliveryStatus: null,\n          dateType: null,\n          createTimes: []\n        },\n        // 表单参数\n        form: {},\n        // 表单校验\n        rules: {},\n        cacheCloumnList: [], //缓存字段列表\n        //缓存名称\n        cacheKey: \"CustomerDelivery\",\n        columnList: [{\n            label: \"单号\",\n            prop: \"orderNo\",\n            visible: true,\n            align: \"center\",\n          },\n          {\n            label: \"日期\",\n            prop: \"orderTime\",\n            visible: true,\n            align: \"center\",\n          },\n          {\n            label: \"合同金额\",\n            prop: \"totalAmount\",\n            visible: true,\n            align: \"center\",\n          },\n          {\n            label: \"已送货\",\n            prop: \"deliveryNum\",\n            visible: true,\n            align: \"center\",\n          },\n          {\n            label: \"未收款\",\n            prop: \"unCollectionAmount\",\n            visible: true,\n            align: \"center\",\n          },\n          {\n            label: \"已收款\",\n            prop: \"collectionAmount\",\n            visible: true,\n            align: \"center\",\n          },\n          {\n            label: \"收款状态\",\n            prop: \"priceStatus\",\n            visible: true,\n            align: \"center\",\n            type: \"dict\",\n            dictType: \"collection_status\"\n          },\n          {\n            label: \"送货状态\",\n            prop: \"deliveryStatus\",\n            visible: true,\n            align: \"center\",\n            type: \"dict\",\n            dictType: \"delivery_status\"\n          },\n        ]\n      };\n    },\n    created() {\n      // this.getList();\n      this.refreshCloumn(this);\n    },\n    methods: {\n      setCustomerId(customerId){\n        this.customerId = customerId\n      },\n      /** 查询客户送货单列表 */\n      getList() {\n        let queryData = {\n          customerId: this.customerId,\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n        }\n        this.loading = true;\n        queryMarketRecord(queryData).then(response => {\n          this.customerDeliveryList = response.rows;\n          this.total = response.total;\n          this.loading = false;\n        });\n      },\n      // 取消按钮\n      cancel() {\n        this.open = false;\n        this.reset();\n      },\n      // 表单重置\n      reset() {\n        this.form = {\n          deliveryId: null,\n          customerId: null,\n          orderId: null,\n          orderNodeId: null,\n          deliveryStatus: null,\n          createTime: null,\n          createBy: null,\n          updateTime: null,\n          updateBy: null\n        };\n        this.resetForm(\"form\");\n      },\n      /** 搜索按钮操作 */\n      handleQuery() {\n        this.queryParams.pageNum = 1;\n        this.getList();\n      },\n      /** 重置按钮操作 */\n      resetQuery() {\n        this.queryParams.createTimes = []\n        this.resetForm(\"queryForm\");\n        this.handleQuery();\n      },\n      // 多选框选中数据\n      handleSelectionChange(selection) {\n        this.ids = selection.map(item => item.deliveryId)\n        this.single = selection.length !== 1\n        this.multiple = !selection.length\n      },\n      /** 新增按钮操作 */\n      handleAdd() {\n        this.$router.push({\n          path: '/salesOrder/add/index',\n          query: {\n            customerId: this.customerId\n          }\n        });\n      },\n      /** 修改按钮操作 */\n      handleUpdate(row) {\n        this.reset();\n        const deliveryId = row.deliveryId || this.ids\n        getCustomerDelivery(deliveryId).then(response => {\n          this.form = response.data;\n          this.open = true;\n          this.title = \"修改客户送货单\";\n        });\n      },\n      handleDelivery(){\n        this.$router.push({\n          path: '/customerDelivery/deliveryRemind/index',\n          query: {\n            customerId: this.customerId\n          }\n        });\n      },\n      /** 提交按钮 */\n      submitForm() {\n        this.$refs[\"form\"].validate(valid => {\n          if (valid) {\n            if (this.form.deliveryId != null) {\n              updateCustomerDelivery(this.form).then(response => {\n                this.$modal.msgSuccess(\"修改成功\");\n                this.open = false;\n                this.getList();\n              });\n            } else {\n              addCustomerDelivery(this.form).then(response => {\n                this.$modal.msgSuccess(\"新增成功\");\n                this.open = false;\n                this.getList();\n              });\n            }\n          }\n        });\n      },\n      /** 删除按钮操作 */\n      handleDelete(row) {\n        const deliveryIds = row.deliveryId || this.ids;\n        this.$modal.confirm('确认删除？').then(function() {\n          return delCustomerDelivery(deliveryIds);\n        }).then(() => {\n          this.getList();\n          this.$modal.msgSuccess(\"删除成功\");\n        }).catch(() => {});\n      },\n      /** 导出按钮操作 */\n      handleExport() {\n        this.download('order/customerDelivery/export', {\n          ...this.queryParams\n        }, `customerDelivery_${new Date().getTime()}.xlsx`)\n      }\n    }\n  };\n</script>\n"],"mappings":";;;;;;;;;;;;;AAsFA,IAAAA,iBAAA,GAAAC,OAAA;AASA,IAAAC,SAAA,GAAAD,OAAA;AAEA,IAAAE,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,OAAA;MACA;MACAC,GAAA;MACA;MACAC,MAAA;MACA;MACAC,QAAA;MACA;MACAC,UAAA;MACA;MACAC,KAAA;MACA;MACAC,oBAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACA;MACAC,WAAA;QACAC,OAAA;QACAC,QAAA;QACAC,UAAA;QACAC,OAAA;QACAC,WAAA;QACAC,gBAAA;QACAC,cAAA;QACAC,QAAA;QACAC,WAAA;MACA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;MACAC,eAAA;MAAA;MACA;MACAC,QAAA;MACAC,UAAA;QACAC,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA,GACA;QACAH,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA,GACA;QACAH,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA,GACA;QACAH,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA,GACA;QACAH,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA,GACA;QACAH,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;MACA,GACA;QACAH,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAAA;QACAC,QAAA;MACA,GACA;QACAL,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,KAAA;QACAC,IAA