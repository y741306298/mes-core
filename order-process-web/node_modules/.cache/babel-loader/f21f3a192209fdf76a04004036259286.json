采购单列表 */\n      getList() {\n        this.loading = true;\n        statementList(this.queryParams).then(response => {\n          this.marketOrderList = response.rows;\n          this.total = response.total;\n          this.loading = false;\n          this.otherData = response.otherData;\n        });\n      }\n    }\n  };\n</script>\n<style lang=\"scss\">\n  .statement-table-title {\n    display: flex;\n\n    div {\n      flex: 1;\n    }\n\n    span {\n      font-size: 1.3em;\n    }\n  }\n  #table td{\n    padding: 10px;\n  }\n</style>\n<style>\n  @media print {\n    @page {\n      margin: 8px 20px 0px 27px;\n      /* margin-left: 30px; */\n      size: auto;\n    }\n\n    @media print {\n      .print-content {\n        max-height: 50vh;\n        /* 设置内容区域的最大高度为视口高度的 90% */\n        /* 其他打印样式 */\n      }\n    }\n\n    body {\n      /* padding: 10mm; */\n    }\n  }\n</style>\n"],"mappings":";;;;;;AAgDA,IAAAA,mBAAA,GAAAC,OAAA;AAEA,IAAAC,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAGA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,OAAA;MACA;MACAC,IAAA;MACA;MACAC,eAAA;MACAC,SAAA;QACAC,WAAA;MACA;MACA;MACAC,QAAA;QACAC,EAAA;MACA;IAEA;EACA;EACAC,OAAA;IACA;AACA;AACA;IACAC,UAAA,WAAAA,WAAA;MACA,KAAAP,IAAA;MACA,KAAAQ,OAAA;IACA;IACA,cACAA,OAAA,WAAAA,QAAA;MAAA,IAAAC,KAAA;MACA,KAAAV,OAAA;MACA,IAAAW,iCAAA,OAAAC,WAAA,EAAAC,IAAA,WAAAC,QAAA;QACAJ,KAAA,CAAAR,eAAA,GAAAY,QAAA,CAAAC,IAAA;QACAL,KAAA,CAAAM,KAAA,GAAAF,QAAA,CAAAE,KAAA;QACAN,KAAA,CAAAV,OAAA;QACAU,KAAA,CAAAP,SAAA,GAAAW,QAAA,CAAAX,SAAA;MACA;IACA;EACA;AACA","ignoreList":[]}]}