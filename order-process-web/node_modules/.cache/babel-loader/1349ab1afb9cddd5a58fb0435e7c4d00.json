ta.deptList\n          }],\n          yAxis: [{\n            type: 'value'\n          }],\n          series: [{\n              name: '按时完成',\n              type: 'bar',\n              stack: 'Ad',\n              emphasis: {\n                focus: 'series'\n              },\n              data: this.resultData.onTimeList,\n              color: '#ed702e'\n            },\n            {\n              name: '超时完成',\n              type: 'bar',\n              stack: 'Ad',\n              emphasis: {\n                focus: 'series'\n              },\n              data: this.resultData.unOnTimeList,\n              color: '#414eec'\n            }\n          ]\n        };\n        //4.使用刚指定的配置项和数据显示图表。\n        myChart.setOption(option);\n\n      }\n    }\n  };\n</script>\n"],"mappings":";;;;;;;;;;AAgBA,IAAAA,OAAA,GAAAC,uBAAA,CAAAC,OAAA;AAEA,IAAAC,WAAA,GAAAD,OAAA;AAEA,IAAAE,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,YAAA;MACA;MACAC,SAAA;QACAC,UAAA;QACAC,cAAA;QACAC,YAAA;MACA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACAD,WAAA,WAAAA,YAAA;MAAA,IAAAE,KAAA;MACA,KAAAP,SAAA,CAAAE,cAAA,QAAAF,SAAA,CAAAC,UAAA;MACA,KAAAD,SAAA,CAAAG,YAAA,QAAAH,SAAA,CAAAC,UAAA;MACA,IAAAO,sBAAA,OAAAR,SAAA,EAAAS,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAAX,UAAA,GAAAc,GAAA,CAAAf,IAAA;QACAY,KAAA,CAAAI,SAAA;MACA;IACA;IACAA,SAAA,WAAAA,UAAA;MAAA,IAAAC,MAAA;MAAA,WAAAC,kBAAA,CAAApB,OAAA,mBAAAqB,aAAA,CAAArB,OAAA,IAAAsB,CAAA,UAAAC,QAAA;QAAA,IAAAC,OAAA,EAAAC,MAAA;QAAA,WAAAJ,aAAA,CAAArB,OAAA,IAAA0B,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA;YAAA;cAEA;cACAJ,OAAA,GAAA9B,OAAA,CAAAmC,IAAA,CAAAC,QAAA,CAAAC,cAAA,mBACA;cAGA;cACAN,MAAA;gBACAO,OAAA;kBACAC,OAAA;kBACAC,WAAA;oBACAC,IAAA;kBACA;gBACA;gBACAC,MAAA;gBACAC,IAAA;kBACAC,IAAA;kBACAC,KAAA;kBACAC,MAAA;kBACAC,YAAA;gBACA;gBACAC,KAAA;kBACAP,IAAA;kBACAjC,IAAA,EAAAiB,MAAA,CAAAhB,UAAA,CAAAC;gBACA;gBACAuC,KAAA;kBACAR,IAAA;gBACA;gBACAS,MAAA;kBACA3C,IAAA;kBACAkC,IAAA;kBACAU,KAAA;kBACAC,QAAA;oBACAC,KAAA;k