   this.userList = res.data;\n        })\n      },\n      /**\n       * 获取订单详情\n       */\n      getOrderInfo() {\n        this.reset();\n        if (!this.orderId) {\n          return;\n        }\n        getSalesOrder(this.orderId).then(res => {\n          this.form = res.data\n          //this.getCustomerAddressList(this.form.customerId)\n        })\n      },\n      /**\n       * 打开客户地址弹框\n       */\n      handleOpenCustomerAddress() {\n        this.$refs.customerAddressInfoRef.handleOpen();\n      },\n      /**\n       * 获取模板列表\n       */\n      getFlowTemplateList() {\n        listFlowTemplateAll({\n          templateStatus: true\n        }).then(res => {\n          this.flowTemplateList = res.data;\n        })\n      },\n      /**\n       * 拼接客户地址\n       */\n      spliceCustomerAddress(customer) {\n        if (customer.addressType == '0') {\n          const address =\n            `${customer.addressShort}-${customer.addressProvince}${customer.addressCity}${customer.addressArea}${customer.addressDetails}`\n          return address;\n        } else {\n          const address =\n            `${customer.destination}-${customer.logisticsCompany}-${customer.addressProvince}${customer.addressCity}${customer.addressArea}${customer.addressDetails}`\n          return address;\n        }\n      },\n      /**\n       * 获取客户地址\n       */\n      getCustomerAddressList(customerId) {\n        listCustomerAddressAll({\n          customerId: customerId\n        }).then(res => {\n          this.customerAddressList = res.data;\n        })\n      },\n      /**\n       * 获取客户列表\n       */\n      getCustomerList() {\n        listCustomerAll().then(res => {\n          this.customerList = res.data;\n        })\n      },\n      // 表单重置\n      reset() {\n        this.form = {\n          orderId: null,\n          orderNo: new Date().getTime(),\n          customerId: null,\n          contact: null,\n          contactTel: null,\n          customerAddressId: null,\n          orderTime: null,\n          deliveryTime: null,\n          templateId: null,\n          craftType: null,\n          totalNum: 0,\n          totalAmount: 0,\n          currencyType: null,\n          attachments: null,\n          userId: null,\n          createTime: null,\n          createBy: null,\n          updateTime: null,\n          updateBy: null,\n          otherFields: null\n        };\n        this.resetForm(\"form\");\n      },\n      isShow(){\n        const permissions = store.getters && store.getters.permissions;\n        if(permissions.includes(\"*:*:*\")||permissions.includes(\"order:show:price\")){\n          this.showPrice = true;\n        }\n      }\n    }\n  };\n</script>\n"],"mappings":";;;;;;;;;;AAwIA,IAAAA,WAAA,GAAAC,OAAA;AASA,IAAAC,SAAA,GAAAD,OAAA;AAIA,IAAAE,gBAAA,GAAAF,OAAA;AAIA,IAAAG,aAAA,GAAAH,OAAA;AAIA,IAAAI,KAAA,GAAAJ,OAAA;AAIA,IAAAK,MAAA,GAAAC,sBAAA,CAAAN,OAAA;AACA,IAAAO,MAAA,GAAAD,sBAAA,CAAAN,OAAA;AAAA,IAAAQ,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,UAAA;IACAC,qBAAA,EAAAA;EACA;EACAC,KAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,SAAA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;MACA;MACAC,YAAA;MACA;MACAC,mBAAA;MACA;MACAC,gBAAA;MACA;MACAC,QAAA;IACA;EACA;EACAC,KAAA;IACAC,OAAA,WAAAA,QAAA;MACA,KAAAC,YAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAD,YAAA;IACA,KAAAE,eAAA;IACA,KAAAC,mBAAA;IACA,KAAAC,WAAA;IACA,KAAAC,MAAA;EACA;EACAC,OAAA;IACA;AACA;AACA;IACAF,WAAA,WAAAA,YAAA;MAAA,IAAAG,KAAA;MACA,IAAAC,iBAAA,IAAAC,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAAV,QAAA,GAAAa,GAAA,CAAApB,IAAA;MACA;IACA;IACA;AACA;AACA;IACAU,YAAA,WAAAA,aAAA;MAAA,IAAAW,MAAA;MACA,KAAAC,KAAA;MACA,UAAAb,OAAA;QACA;MACA;MACA,IAAAc,yBAAA,OAAAd,OAAA,EAAAU,IAAA,WAAAC,GAAA;QACAC,MAAA,CAAAnB,IAAA,GAAAkB,GAAA,CAAApB,IAAA;QACA;MACA;IACA;IACA;AACA;AACA;IACAwB,yBAAA,WAAAA,0BAAA;MACA,KAAAC,KAAA,CAAAC,sBAAA,CAAAC,UAAA;IACA;IACA;AACA;AACA;IACAd,mBAAA,WAAAA,oBAAA;MAAA,IAAAe,MAAA;MACA,IAAAC,iCAAA;QACAC,cAAA;MACA,GAAAX,IAAA,WAAAC,GAAA;QACAQ,MAAA,CAAAtB,gBAAA,GAAAc,GAAA,CAAApB,IAAA;MACA;IACA;IACA;AACA;AACA;IACA+B,qBAAA,WAAAA,sB