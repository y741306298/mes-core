l-row style=\"text-align: center;margin-bottom: 10px;\">\n                    <div style=\"font-size: 2em;font-weight: 700;\">BRT</div>\n                    <div>\n                        <span style=\"font-size: 1.6em;\">入库单 </span>\n                    </div>\n                </el-row>\n                <el-row style=\"margin-bottom: 10px;\">\n                    <el-col :span=\"18\">生成单号：{{printData.orderNo}}</el-col>\n                    <el-col :span=\"4\">领料日期：{{parseTime(printData.dataDate, '{y}-{m}-{d}')}}</el-col>\n                </el-row>\n\n                <div>\n                    <table style=\"width: 100%;text-align: center;\">\n\n                        <tr>\n                            <td>序号</td>\n                            <td>物料编码</td>\n                            <td>物料名称</td>\n                            <td>规格型号</td>\n                            <td>单位</td>\n                            <td>数量</td>\n                            <td>供应商</td>\n                            <td>批号</td>\n                        </tr>\n\n                        <tr v-for=\"(item, index) in list\" :key=\"index\">\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                            <td>{{ item.val1 }}</td>\n                        </tr>\n\n                    </table>\n\n                    <el-row style=\"margin-top: 10px;\">\n                        <el-col :span=\"10\">出库人：</el-col>\n                        <el-col :span=\"8\">领料部门：</el-col>\n                        <el-col :span=\"4\">领料人：</el-col>\n                    </el-row>\n\n                </div>\n            </div>\n            <span slot=\"footer\" class=\"dialog-footer\">\n                <el-button @click=\"open = false\">取 消</el-button>\n                <el-button type=\"primary\" v-print=\"printAre\">确 定</el-button>\n            </span>\n        </el-dialog>\n\n\n\n    </div>\n</template>\n\n<script>\n\nimport {\n    getPrintData\n} from \"@/api/order/customerDelivery\";\n\nexport default {\n    name: \"CustomerDeliveryPrint\",\n    props: ['orderId'],\n    data() {\n        return {\n            // 打印设置\n            printAre: {\n                id: \"issuedoc\",\n            },\n            // 表单参数\n            form: {},\n            // 表单校验\n            rules: {},\n            // 是否打开弹框\n            open: false,\n            // 订单详情列表\n            printData: {},\n            list: [\n                { val1: '1' }\n            ]\n        };\n    },\n    methods: {\n\n        OnClick(e) {\n            console.log(e);\n            this.open = true\n        },\n        /**\n         * 获取订单详情列表\n         */\n        getPrintData(orderId) {\n            const query = {\n                orderId: orderId\n            };\n            getPrintData(query).then(res => {\n                this.printData = res.data;\n                this.list = res.data.list;\n            })\n        },\n\n        /**\n         * 打开弹框\n         */\n        handleOpen(orderId) {\n            this.open = true;\n            this.getPrintData(orderId);\n        },\n\n        // 表单重置\n        reset() {\n            this.form = {\n                orderId: null,\n                orderNo: new Date().getTime(),\n                customerId: null,\n                contact: null,\n                contactTel: null,\n                customerAddressId: null,\n                orderTime: null,\n                deliveryTime: null,\n                templateId: null,\n                craftType: null,\n                totalNum: 0,\n                totalAmount: 0,\n                currencyType: null,\n                attachments: null,\n                userId: null,\n                createTime: null,\n                createBy: null,\n                updateTime: null,\n                updateBy: null\n            };\n            this.resetForm(\"form\");\n        },\n    }\n};\n</script>\n\n<style scoped>\ntable,\nth,\ntd {\n    border: 2px solid black;\n    border-collapse: collapse;\n    /* 使得相邻的边框合并为一个单一的边框 */\n}\n\ntd {\n    padding: 5px 0;\n    width: 10%;\n}\n</style>\n<style>\n.el-dialog__body {\n    background-color: white !important;\n}\n\n@media print {\n    @page {\n        margin: 8px 20px 0px 27px;\n        /* margin-left: 30px; */\n        /* size: auto; */\n    }\n\n    @media print {\n        .print-content {\n            max-height: 50vh;\n            /* 设置内容区域的最大高度为视口高度的 90% */\n            /* 其他打印样式 */\n        }\n    }\n\n    body {\n        /* padding: 10mm; */\n    }\n}\n</style>\n<style scoped>\ntable,\nth,\ntd {\n    border: 2px solid black;\n    border-collapse: collapse;\n    /* 使得相邻的边框合并为一个单一的边框 */\n}\n\ntd {\n    padding: 10px 0;\n    width: 12%;\n}\n</style>\n"],"mappings":";;;;;;AAgEA,IAAAA,iBAAA,GAAAC,OAAA;AAEA,IAAAC,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,QAAA;QACAC,EAAA;MACA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACA;MACAC,SAAA;MACAC,IAAA,GACA;QAAAC,IAAA;MAAA;IAEA;EACA;EACAC,OAAA;IAEAC,OAAA,WAAAA,QAAAC,CAAA;MACAC,OAAA,CAAAC,GAAA,CAAAF,CAAA;MACA,KAAAN,IAAA;IACA;IACA;AACA;AACA;IACAS,YAAA,WAAAA,aAAAC,OAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,KAAA;QACAF,OAAA,EAAAA;MACA;MACA,IAAAD,8BAAA,EAAAG,KAAA,EAAAC,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAAV,SAAA,GAAAa,GAAA,CAAAnB,IAAA;QACAgB,KAAA,CAAAT,IAAA,GAAAY,GAAA,CAAAnB,IAAA,CAAAO,IAAA;MACA;IACA;IAEA;AACA;AACA;IACAa,UAAA,WAAAA,WAAAL,OAAA;MACA,KAAAV,IAAA;MACA,KAAAS,YAAA,CAAAC,OAAA;IACA;IAEA;IACAM,KAAA,WAAAA,MAAA;MACA,KAAAlB,IAAA;QACAY,OAAA;QACAO,OAAA,MAAAC,IAAA,GAAAC,OAAA;QACAC,UAAA;QACAC,OAAA;QACAC,UAAA;QACAC,iBAAA;QACAC,SAAA;QACAC,YAAA;QACAC,UAAA;QACAC,SAAA;QACAC,QAAA;QACAC,WAAA;QACAC,YAAA;QACAC,WAAA;QACAC,MAAA;QACAC,UAAA;QACAC,QAAA