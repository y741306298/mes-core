argin-bottom: 10px;\">\n          <div style=\"font-size: 2em;font-weight: 700;\">BRT</div>\n          <div>\n            <span style=\"font-size: 1em;\">地址：高新区星火大道3号B3-1</span>\n          </div>\n          <div>\n            <span style=\"font-size: 1em;\">TEL：029-33112155</span>\n          </div>\n        </el-row>\n\n        <div style=\"text-align: center;\">\n          <span style=\"font-size: 1.5em;\">送货单</span>\n          <span style=\"font-size: 0.8em; position: absolute;right:20%\">时间：{{parseTime(printData.dataDate)}}</span>\n        </div>\n        <el-descriptions title=\"\">\n          <el-descriptions-item label=\"客户名称\">{{ printData.customerName }}</el-descriptions-item>\n          <el-descriptions-item label=\"客户电话\">{{ printData.orderNo }}</el-descriptions-item>\n          <el-descriptions-item label=\"制单人员\">{{ printData.contact }}</el-descriptions-item>\n\n          <el-descriptions-item label=\"送货地址\">{{ printData.address }}</el-descriptions-item>\n          <el-descriptions-item label=\"联系人\">{{ printData.thisUser }}</el-descriptions-item>\n          <el-descriptions-item label=\"送货日期\">{{ parseTime(printData.dataDate, '{y}-{m}-{d}') }}</el-descriptions-item>\n        </el-descriptions>\n        <table style=\"width: 100%;border-collapse: collapse;border-spacing: 0;text-align: center;\" border=\"1\">\n          <thead>\n            <tr>\n              <td>序号</td>\n              <td>产品名称</td>\n              <td>料号</td>\n              <td>规格</td>\n              <td>单位</td>\n              <td>数量</td>\n              <td>单价</td>\n              <td>金额</td>\n              <td>备注</td>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"(item, index) in list\">\n              <td>{{ index + 1 }}</td>\n              <td>{{ item.materielName }}</td>\n              <td>{{ item.spec }}</td>\n              <td>{{ item.spec }}</td>\n              <td>{{ item.unit }}</td>\n              <td>{{ item.detailsNum }}</td>\n              <td>{{ item.price }}</td>\n              <td>{{ item.amount }}</td>\n              <td>{{ item.remark }}</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <div >\n        注：以上货品请核对数量，如有质量问题，请在收货后3天内通知本公司，逾期恕不负责。\n      </div>\n      <div style=\"width: 100%\">\n        送货单位及经手人（盖章）：\n        <span style=\"position: absolute;right:20%\">\n           收货单位及经手人（盖章）：\n        </span>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"open = false\">取 消</el-button>\n        <el-button type=\"primary\" v-print=\"printAre\">确 定</el-button>\n      </span>\n    </el-dialog>\n\n\n\n  </div>\n</template>\n\n<script>\n\nimport {\n  getPrintData\n} from \"@/api/order/customerDelivery\";\n\nexport default {\n  name: \"CustomerDeliveryPrint\",\n  props: ['orderId'],\n  data() {\n    return {\n      // 打印设置\n      printAre: {\n        id: \"customerDeliveryPrint\",\n      },\n      // 表单参数\n      form: {},\n      // 表单校验\n      rules: {},\n      // 是否打开弹框\n      open: false,\n      // 订单详情列表\n      printData: {},\n      list: []\n    };\n  },\n  methods: {\n    /**\n     * 获取订单详情列表\n     */\n    getPrintData(orderId) {\n      const query = {\n        orderId: orderId\n      };\n      getPrintData(query).then(res => {\n        this.printData = res.data;\n        this.list = res.data.list;\n      })\n    },\n\n    /**\n     * 打开弹框\n     */\n    handleOpen(orderId) {\n      this.open = true;\n      this.getPrintData(orderId);\n    },\n\n    // 表单重置\n    reset() {\n      this.form = {\n        orderId: null,\n        orderNo: new Date().getTime(),\n        customerId: null,\n        contact: null,\n        contactTel: null,\n        customerAddressId: null,\n        orderTime: null,\n        deliveryTime: null,\n        templateId: null,\n        craftType: null,\n        totalNum: 0,\n        totalAmount: 0,\n        currencyType: null,\n        attachments: null,\n        userId: null,\n        createTime: null,\n        createBy: null,\n        updateTime: null,\n        updateBy: null\n      };\n      this.resetForm(\"form\");\n    },\n  }\n};\n</script>\n<style>\n.el-dialog__body {\n  background-color: white !important;\n}\n\n@media print {\n  @page {\n    margin: 8px 20px 0px 27px;\n    /* margin-left: 30px; */\n    /* size: auto; */\n  }\n\n  @media print {\n    .print-content {\n      max-height: 50vh;\n      /* 设置内容区域的最大高度为视口高度的 90% */\n      /* 其他打印样式 */\n    }\n  }\n\n  body {\n    /* padding: 10mm; */\n  }\n}\n</style>\n"],"mappings":";;;;;;AA8EA,IAAAA,iBAAA,GAAAC,OAAA;AAEA,IAAAC,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,QAAA;QACAC,EAAA;MACA;MACA;MACAC,IAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACA;MACAC,SAAA;MACAC,IAAA;IACA;EACA;EACAC,OAAA;IACA;AACA;AACA;IACAC,YAAA,WAAAA,aAAAC,OAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,KAAA;QACAF,OAAA,EAAAA;MACA;MACA,IAAAD,8BAAA,EAAAG,KAAA,EAAAC,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAAL,SAAA,GAAAQ,GAAA,CAAAd,IAAA;QACAW,KAAA,CAAAJ,IAAA,GAAAO,GAAA,CAAAd,IAAA,CAAAO,IAAA;MACA;IACA;IAEA;AACA;AACA;IACAQ,UAAA,WAAAA,WAAAL,OAAA;MACA,KAAAL,IAAA;MACA,KAAAI,YAAA,CAAAC,OAAA;IACA;IAEA;IACAM,KAAA,WAAAA,MAAA;MACA,KAAAb,IAAA;QACAO,OAAA;QACAO,OAAA,MAAAC,IAAA,GAAAC,OAAA;QACAC,UAAA;QACAC,OAAA;QACAC,UAAA;QACAC,iBAAA;QACAC,SAAA;QACAC,YAAA;QACAC,UAAA;QACAC,SAAA;QACAC,QAAA;QACAC,WAAA;QACAC,YAAA;QACAC,WAAA;QACAC,MAAA;QACAC,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACA,KAAAC,SAAA;IACA;EACA;AACA","ignoreList":[]}]}