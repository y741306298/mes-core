pse;border-spacing: 0;text-align: center;\" border=\"1\">\n          <thead>\n            <tr>\n              <th>采购日期</th>\n              <th>客户名称</th>\n              <th>产品名称</th>\n              <th>总数量</th>\n              <th>总额</th>\n              <th>业务员</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"(item,index) in marketOrderList\">\n              <td>{{parseTime(item.marketOrderVo.orderTime,'{y}-{m}-{d}')}}</td>\n              <td>{{item.supplierName}}</td>\n              <td>{{item.materielVo?item.materielVo.materielName:item.materielId}}</td>\n              <td>{{item.marketOrderVo.totalNum}}</td>\n              <td>{{item.marketOrderVo.totalAmount}}</td>\n              <td>{{item.user.userName}}</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"open = false\">取 消</el-button>\n        <el-button type=\"primary\" v-print=\"printAre\">确 定</el-button>\n      </span>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\n  import {\n    statementList\n  } from \"@/api/order/marketOrderDetails\";\n\n\n  export default {\n    name: \"printMarketOrder\",\n    props: ['queryParams'],\n    data() {\n      return {\n        // 遮罩层\n        loading: true,\n        // 是否打开弹框\n        open: false,\n        // 采购单表格数据\n        marketOrderList: [],\n        otherData: {\n          totalAmount: 0\n        },\n        // 打印设置\n        printAre: {\n          id: \"printAre\",\n        },\n\n      };\n    },\n    methods: {\n      /**\n       * 打开弹框\n       */\n      handleOpen() {\n        this.open = true;\n        this.getList();\n      },\n      /** 查询采购单列表 */\n      getList() {\n        this.loading = true;\n        statementList(this.queryParams).then(response => {\n          this.marketOrderList = response.rows;\n          this.total = response.total;\n          this.loading = false;\n          this.otherData = response.otherData;\n        });\n      }\n    }\n  };\n</script>\n<style lang=\"scss\">\n  .statement-table-title {\n    display: flex;\n\n    div {\n      flex: 1;\n    }\n\n    span {\n      font-size: 1.3em;\n    }\n  }\n  #table td{\n    padding: 10px;\n  }\n</style>\n<style>\n  @media print {\n    @page {\n      margin: 8px 20px 0px 27px;\n      /* margin-left: 30px; */\n      size: auto;\n    }\n\n    @media print {\n      .print-content {\n        max-height: 50vh;\n        /* 设置内容区域的最大高度为视口高度的 90% */\n        /* 其他打印样式 */\n      }\n    }\n\n    body {\n      /* padding: 10mm; */\n    }\n  }\n</style>\n"]}]}