{"remainingRequest":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\customerAddress\\list.vue?vue&type=style&index=0&id=735c6292&lang=scss","dependencies":[{"path":"D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\customerAddress\\list.vue","mtime":1743132727000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\sass-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:Ci5jdXN0b21lckFkZHJlc3N7CiAgLmVsLXRhYmxlX19oZWFkZXItd3JhcHBlciB7CiAgICBkaXNwbGF5OiBub25lOwogIH0KfQoK"},{"version":3,"sources":["list.vue"],"names":[],"mappings":";AAkHA;AACA;AACA;AACA;AACA","file":"list.vue","sourceRoot":"src/views/order/customerAddress","sourcesContent":["<template>\n  <div class=\"customerAddress\">\n    <el-table :data=\"customerAddressList\" style=\"width: 70%\">\n      <el-table-column label=\"地址类型\" align=\"center\" width=\"100\">\n        <template slot-scope=\"scope\">\n          <div style=\"display: flex;\">\n            <i class=\"el-icon-location-outline mt5 mr5\"></i>\n            <dict-tag :options=\"dict.type.address_type\" :value=\"scope.row.addressType\" />\n          </div>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"详细地址\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <span>\n            {{scope.row.addressShort}}-{{scope.row.destination}}-{{scope.row.logisticsCompany}}-{{scope.row.addressProvince}}{{scope.row.addressCity}}{{scope.row.addressArea}}{{scope.row.addressDetails}}-{{scope.row.addressRemark}}\n          </span>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"邮编\" prop=\"postcode\" width=\"100\"/>\n      <el-table-column label=\"操作\" align=\"center\" width=\"100\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"text\" icon=\"el-icon-edit\" @click=\"handleUpdate(scope.row)\"\n            v-hasPermi=\"['order:customerAddress:edit']\"></el-button>\n          <el-button type=\"text\" icon=\"el-icon-delete\" @click=\"handleDelete(scope.row)\"\n            v-hasPermi=\"['order:customerAddress:remove']\"></el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <!-- 客户地址弹框 -->\n    <customer-address-info  @getCustomerAddressList=\"getList\" ref=\"customerAddressInfoRef\"></customer-address-info>\n\n  </div>\n</template>\n\n<script>\n  import {\n    listCustomerAddress,\n    listCustomerAddressAll,\n    getCustomerAddress,\n    delCustomerAddress,\n    addCustomerAddress,\n    updateCustomerAddress\n  } from \"@/api/order/customerAddress\";\n\n  import customerAddressInfo from '@/views/order/customerAddress/info'\n\n  export default {\n    name: \"CustomerAddressList\",\n    dicts: ['address_type'],\n    props: ['customerId'],\n    components: {\n      customerAddressInfo\n    },\n    data() {\n      return {\n        // 遮罩层\n        loading: true,\n        // 用户地址表格数据\n        customerAddressList: [],\n        queryParams: {\n          customerId: null\n        }\n      };\n    },\n    watch:{\n      customerId:function(){\n        this.getList();\n      }\n    },\n    created() {\n      this.getList();\n    },\n    methods: {\n      /** 查询用户地址列表 */\n      getList() {\n        this.loading = true;\n        if(!this.customerId){\n          this.customerAddressList = [];\n          this.loading = false;\n          return;\n        }\n        this.queryParams.customerId = this.customerId;\n        listCustomerAddressAll(this.queryParams).then(response => {\n          this.customerAddressList = response.data;\n          this.loading = false;\n        });\n      },\n      /** 修改按钮操作 */\n      handleUpdate(row) {\n        this.$refs.customerAddressInfoRef.handleOpen(row.addressId)\n      },\n      /** 删除按钮操作 */\n      handleDelete(row) {\n        const addressIds = row.addressId || this.ids;\n        this.$modal.confirm('确认删除？').then(function() {\n          return delCustomerAddress(addressIds);\n        }).then(() => {\n          this.getList();\n          this.$modal.msgSuccess(\"删除成功\");\n        }).catch(() => {});\n      },\n    }\n  };\n</script>\n<style lang=\"scss\">\n  .customerAddress{\n    .el-table__header-wrapper {\n      display: none;\n    }\n  }\n\n</style>\n"]}]}