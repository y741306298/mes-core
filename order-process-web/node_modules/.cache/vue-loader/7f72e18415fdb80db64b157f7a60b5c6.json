{"remainingRequest":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\salesOrder\\list.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\salesOrder\\list.vue","mtime":1766480223172},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["list.vue"],"names":[],"mappings":";AAmFA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"list.vue","sourceRoot":"src/views/order/salesOrder","sourcesContent":["<template>\r\n  <div class=\"app-container\">\r\n    <el-form :model=\"queryParams\" ref=\"queryForm\" size=\"small\" :inline=\"true\" v-show=\"showSearch\" label-width=\"68px\">\r\n      <el-form-item label=\"日期\" prop=\"dateType\">\r\n        <el-select v-model=\"queryParams.dateType\" filterable clearable>\r\n          <el-option value=\"0\" label=\"当日\"></el-option>\r\n          <el-option value=\"1\" label=\"昨日\"></el-option>\r\n          <el-option value=\"2\" label=\"当月\"></el-option>\r\n          <el-option value=\"3\" label=\"本季度\"></el-option>\r\n          <el-option value=\"4\" label=\"本年\"></el-option>\r\n        </el-select>\r\n      </el-form-item>\r\n      <el-form-item label=\"\" prop=\"\">\r\n        <el-date-picker v-model=\"queryParams.createTimes\" value-format=\"yyyy-MM-dd\" type=\"daterange\" range-separator=\"至\" start-placeholder=\"开始日期\"\r\n          end-placeholder=\"结束日期\">\r\n        </el-date-picker>\r\n      </el-form-item>\r\n      <el-form-item label=\"来源单号\" prop=\"orderSn\">\r\n        <el-input v-model=\"queryParams.orderSn\" placeholder=\"请输入来源单号\" clearable @keyup.enter.native=\"handleQuery\" />\r\n      </el-form-item>\r\n      <el-form-item label=\"单号\" prop=\"orderNo\">\r\n        <el-input v-model=\"queryParams.orderNo\" placeholder=\"请输入单号\" clearable @keyup.enter.native=\"handleQuery\" />\r\n      </el-form-item>\r\n      <el-form-item label=\"业务员\" prop=\"userId\">\r\n        <el-select v-model=\"queryParams.userId\" clearable filterable class=\"drag-screenful-contnet\">\r\n          <el-option v-for=\"(item,index) in salesmanUserList\" :value=\"item.userId\" :label=\"item.userName\"></el-option>\r\n        </el-select>\r\n      </el-form-item>\r\n      <el-form-item>\r\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\r\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\r\n      </el-form-item>\r\n    </el-form>\r\n\r\n    <el-row :gutter=\"10\" class=\"mb8\">\r\n      <el-col :span=\"1.5\">\r\n        <el-button type=\"primary\" plain icon=\"el-icon-plus\" size=\"mini\" @click=\"handleAdd\"\r\n          v-hasPermi=\"['order:salesOrder:add']\">新增</el-button>\r\n      </el-col>\r\n      <right-toolbar :columns=\"columnList\" :cacheKey=\"cacheKey\" :showSearch.sync=\"showSearch\"\r\n        @queryTable=\"getList\"></right-toolbar>\r\n    </el-row>\r\n\r\n    <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"salesOrderList\"\r\n      @selection-change=\"handleSelectionChange\">\r\n      <el-table-column label=\"序号\" type=\"index\" width=\"50\" align=\"center\" />\r\n      <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\r\n      <!-- 循环字段 -->\r\n      <template v-for=\"(item,index) in cacheCloumnList\">\r\n        <el-table-column v-if=\"item.visible\" :label=\"item.label\" :prop=\"item.prop\" :width=\"item.width||''\"\r\n          :align=\"item.align||'center'\">\r\n          <template slot-scope=\"scope\">\r\n            <!-- 字典 -->\r\n            <dict-tag v-if=\"item.type == 'dict'\" :options=\"dict.type[item.dictType]\" :value=\"scope.row[item.prop]\" />\r\n            <dict-tag v-else-if=\"item.type == 'objDict'\" :options=\"dict.type[item.dictType]\"\r\n              :value=\"getObjAttr(scope.row, item.prop)\" />\r\n            <!-- 日期 -->\r\n            <span v-else-if=\"item.type == 'date'\">{{ parseTime(scope.row[item.prop], item.dateFormat) }}</span>\r\n            <!-- 图片 -->\r\n            <image-preview v-else-if=\"item.type == 'img'\" :src=\"scope.row[item.prop]\" :width=\"50\" :height=\"50\" />\r\n            <!-- 多层对象 -->\r\n            <span v-else-if=\"item.type == 'obj'\">{{ getObjAttr(scope.row, item.prop) }}</span>\r\n            <!-- 其他 -->\r\n            <template v-else-if=\"item.type == 'other'\">\r\n              <el-button v-if=\"item.prop == 'orderNo'\" type=\"text\" @click=\"toOrderDetails(scope.row)\">{{scope.row.orderNo}}</el-button>\r\n              <span v-if=\"item.prop == 'notCollectionAmount'\">\r\n                {{scope.row.totalAmount - scope.row.collectionAmount}}\r\n              </span>\r\n            </template>\r\n            <span v-else>{{scope.row[item.prop]}}</span>\r\n          </template>\r\n        </el-table-column>\r\n      </template>\r\n    </el-table>\r\n\r\n    <pagination v-show=\"total>0\" :total=\"total\" :page.sync=\"queryParams.pageNum\" :limit.sync=\"queryParams.pageSize\"\r\n      @pagination=\"getList\" />\r\n\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n  import {\r\n    listSalesOrder,\r\n    listSalesOrderAll,\r\n    getSalesOrder,\r\n    delSalesOrder,\r\n    addSalesOrder,\r\n    updateSalesOrder\r\n  } from \"@/api/order/salesOrder\";\r\n\r\n  import {\r\n    listAllUser\r\n  } from \"@/api/system/user\";\r\n\r\n  export default {\r\n    name: \"SalesOrderList\",\r\n    dicts: ['collection_status'],\r\n    data() {\r\n      return {\r\n        // 遮罩层\r\n        loading: true,\r\n        // 选中数组\r\n        ids: [],\r\n        // 非单个禁用\r\n        single: true,\r\n        // 非多个禁用\r\n        multiple: true,\r\n        // 显示搜索条件\r\n        showSearch: true,\r\n        // 总条数\r\n        total: 0,\r\n        // 销售单表格数据\r\n        salesOrderList: [],\r\n        // 查询参数\r\n        queryParams: {\r\n          pageNum: 1,\r\n          pageSize: 10,\r\n          orderNo: null,\r\n          orderSn: null,\r\n          customerId: null,\r\n          contact: null,\r\n          contactTel: null,\r\n          customerAddressId: null,\r\n          orderTime: null,\r\n          deliveryTime: null,\r\n          templateId: null,\r\n          craftType: null,\r\n          totalNum: null,\r\n          totalAmount: null,\r\n          currencyType: null,\r\n          attachments: null,\r\n          userId: null,\r\n          dateType: null,\r\n          createTimes: [],\r\n          createTimeStart: null,\r\n          createTimeEnd: null\r\n        },\r\n        cacheCloumnList: [], //缓存字段列表\r\n        //缓存名称\r\n        cacheKey: \"SalesOrderList\",\r\n        columnList: [{\r\n            label: \"单号\",\r\n            prop: \"orderNo\",\r\n            visible: true,\r\n            align: \"center\",\r\n            type: \"other\",\r\n            width: 150\r\n          },\r\n          {\r\n            label: \"来源单号\",\r\n            prop: \"orderSn\",\r\n            visible: true,\r\n            align: \"center\",\r\n            width: 180\r\n          },\r\n          {\r\n            label: \"日期\",\r\n            prop: \"orderTime\",\r\n            visible: true,\r\n            align: \"center\",\r\n            type: \"date\",\r\n            dateFormat: \"{y}-{m}-{d}\"\r\n          },\r\n          {\r\n            label: \"合同金额\",\r\n            prop: \"totalAmount\",\r\n            visible: true,\r\n            align: \"center\",\r\n          },\r\n          {\r\n            label: \"未收款\",\r\n            prop: \"notCollectionAmount\",\r\n            visible: true,\r\n            align: \"center\",\r\n            type: \"other\"\r\n          },\r\n          {\r\n            label: \"已收款\",\r\n            prop: \"collectionAmount\",\r\n            visible: true,\r\n            align: \"center\",\r\n          },\r\n          {\r\n            label: \"收款状态\",\r\n            prop: \"collectionStatus\",\r\n            visible: true,\r\n            align: \"center\",\r\n            dictType: \"collection_status\",\r\n            type: \"dict\"\r\n          },\r\n        ],\r\n        // 业务员列表\r\n        salesmanUserList: [],\r\n      };\r\n    },\r\n    created() {\r\n      this.getList();\r\n      this.refreshCloumn(this);\r\n      this.getSalesmanUserList();\r\n    },\r\n    methods: {\r\n      /**\r\n       * 获取业务员列表\r\n       */\r\n      getSalesmanUserList() {\r\n        listAllUser({\r\n          roleId: 2\r\n        }).then(res => {\r\n          this.salesmanUserList = res.data\r\n        })\r\n      },\r\n      /**\r\n       * 跳转订单详情\r\n       */\r\n      toOrderDetails(row){\r\n        this.$router.push({\r\n          path: '/salesOrder/info/index',\r\n          query: {\r\n            orderId: row.orderId\r\n          }\r\n        });\r\n      },\r\n      /** 查询销售单列表 */\r\n      getList() {\r\n        this.loading = true;\r\n        if(this.queryParams.createTimes!=null && this.queryParams.createTimes.length>0){\r\n          this.queryParams.createTimeStart = this.queryParams.createTimes[0]\r\n          this.queryParams.createTimeEnd = this.queryParams.createTimes[1]\r\n        }else{\r\n          this.queryParams.createTimeStart = null\r\n          this.queryParams.createTimeEnd = null\r\n        }\r\n        this.queryParams.customerId = this.$route.query.customerId;\r\n        listSalesOrder(this.queryParams).then(response => {\r\n          this.salesOrderList = response.rows;\r\n          this.total = response.total;\r\n          this.loading = false;\r\n        });\r\n      },\r\n      /** 搜索按钮操作 */\r\n      handleQuery() {\r\n        this.queryParams.pageNum = 1;\r\n        this.getList();\r\n      },\r\n      /** 重置按钮操作 */\r\n      resetQuery() {\r\n        this.resetForm(\"queryForm\");\r\n        this.handleQuery();\r\n      },\r\n      // 多选框选中数据\r\n      handleSelectionChange(selection) {\r\n        this.ids = selection.map(item => item.orderId)\r\n        this.single = selection.length !== 1\r\n        this.multiple = !selection.length\r\n      },\r\n      /** 新增按钮操作 */\r\n      handleAdd() {\r\n        this.$router.push({\r\n          path: '/salesOrder/add/index',\r\n          query: {\r\n            customerId: this.queryParams.customerId\r\n          }\r\n        });\r\n      }\r\n    }\r\n  };\r\n</script>\r\n"]}]}