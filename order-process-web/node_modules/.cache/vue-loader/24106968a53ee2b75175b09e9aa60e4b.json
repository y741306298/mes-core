{"remainingRequest":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\supplier\\print.vue?vue&type=style&index=0&id=bafc29b6&lang=css","dependencies":[{"path":"D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\supplier\\print.vue","mtime":1743132727000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["print.vue"],"names":[],"mappings":";AAmHA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"print.vue","sourceRoot":"src/views/order/supplier","sourcesContent":["<template>\n  <div class=\"app-container\">\n    <el-dialog title=\"打印\" :visible.sync=\"open\" width=\"70%\">\n      <div id=\"printAre\">\n        <div style=\"text-align: center;\">\n          <h1>客 户</h1>\n        </div>\n        <hr class=\"mt20 mb20\"/>\n        <el-descriptions title=\"\" size=\"medium\" :column=\"2\">\n          <el-descriptions-item label=\"供应商名称\">{{form.supplierName}}</el-descriptions-item>\n          <el-descriptions-item label=\"供应商类型\">\n            <dict-tag :options=\"dict.type.supplier_type\" :value=\"form.supplierType\" />\n          </el-descriptions-item>\n          <el-descriptions-item label=\"联系人\">{{form.linkman}}</el-descriptions-item>\n          <el-descriptions-item label=\"联系电话\">{{form.phone}}</el-descriptions-item>\n          <el-descriptions-item :span=\"2\" label=\"业务员\" v-if=\"form.user\">{{form.user.userName}}</el-descriptions-item>\n        </el-descriptions>\n        <hr class=\"mt20 mb20\"/>\n        <div class=\"mb20\">备注:{{form.remark}}</div>\n        <div class=\"mt20\">\n          <span>地址:</span>\n          <span class=\"mt10\">\n            {{form.action}}\n          </span>\n        </div>\n\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"open = false\">取 消</el-button>\n        <el-button type=\"primary\" v-print=\"printAre\">确 定</el-button>\n      </span>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\n  import {\n    listSupplier,\n    listSupplierAll,\n    getSupplier,\n    delSupplier,\n    addSupplier,\n    updateSupplier\n  } from \"@/api/order/supplier\";\n\n\n  export default {\n    name: \"SupplierPrint\",\n    dicts:['supplier_type'],\n    data() {\n      return {\n        // 打印设置\n        printAre: {\n          id: \"printAre\",\n        },\n        // 表单参数\n        form: {},\n        // 表单校验\n        rules: {},\n        // 是否打开弹框\n        open: false,\n        // 供应商地址列表\n        supplierAddressList: []\n      };\n    },\n    created() {},\n    methods: {\n\n      /**\n       * 打开弹框\n       */\n      handleOpen(supplierId) {\n        this.open = true;\n        this.getSupplierInfo(supplierId);\n        this.getSupplierAddressList(supplierId);\n      },\n      /**\n       * 获取供应商信息\n       */\n      getSupplierInfo(supplierId) {\n        getSupplier(supplierId).then(res => {\n          this.form = res.data;\n        })\n      },\n\n    }\n  };\n</script>\n<style>\n  .el-dialog__body {\n    background-color: white !important;\n  }\n\n  @media print {\n    @page {\n      margin: 8px 20px 0px 27px;\n      /* margin-left: 30px; */\n      /* size: auto; */\n    }\n\n    @media print {\n      .print-content {\n        max-height: 50vh;\n        /* 设置内容区域的最大高度为视口高度的 90% */\n        /* 其他打印样式 */\n      }\n    }\n\n    body {\n      /* padding: 10mm; */\n    }\n  }\n</style>\n"]}]}