{"remainingRequest":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\supplier\\index.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\work\\order-process-main\\order-process-web\\src\\views\\order\\supplier\\index.vue","mtime":1743132727000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\work\\order-process-main\\order-process-web\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";AAiKA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;;AAGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/views/order/supplier","sourcesContent":["<template>\n  <div class=\"app-container\">\n    <el-form :model=\"queryParams\" ref=\"queryForm\" size=\"small\" :inline=\"true\" v-show=\"showSearch\" label-width=\"68px\">\n      <el-form-item label=\"搜索\" prop=\"keyWords\">\n        <el-input v-model=\"queryParams.keyWords\" placeholder=\"请输入供应商名称/供应商编号\" clearable\n          @keyup.enter.native=\"handleQuery\" />\n      </el-form-item>\n      <el-form-item label=\"联系电话\" prop=\"phone\">\n        <el-input v-model=\"queryParams.phone\" placeholder=\"请输入联系电话\" clearable @keyup.enter.native=\"handleQuery\" />\n      </el-form-item>\n      <el-form-item label=\"供应商类型\" prop=\"supplierType\" label-width=\"120\">\n        <el-select v-model=\"queryParams.supplierType\" clearable filterable class=\"drag-screenful-contnet\">\n          <el-option v-for=\"dict in dict.type.supplier_type\" :key=\"dict.value\" :value=\"dict.value\"\n            :label=\"dict.label\"></el-option>\n        </el-select>\n      </el-form-item>\n      <el-form-item label=\"日期\" prop=\"dateType\">\n        <el-select v-model=\"queryParams.dateType\" filterable clearable>\n          <el-option value=\"0\" label=\"当日\"></el-option>\n          <el-option value=\"1\" label=\"昨日\"></el-option>\n          <el-option value=\"2\" label=\"当月\"></el-option>\n          <el-option value=\"3\" label=\"本季度\"></el-option>\n          <el-option value=\"4\" label=\"本年\"></el-option>\n        </el-select>\n      </el-form-item>\n      <el-form-item label=\"\" prop=\"\">\n        <el-date-picker v-model=\"queryParams.createTimes\" value-format=\"yyyy-MM-dd\" type=\"daterange\" range-separator=\"至\"\n          start-placeholder=\"开始日期\" end-placeholder=\"结束日期\">\n        </el-date-picker>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\n      </el-form-item>\n    </el-form>\n\n    <el-row :gutter=\"10\" class=\"mb8\">\n      <el-col :span=\"1.5\">\n        <el-button type=\"primary\" plain icon=\"el-icon-plus\" size=\"mini\" @click=\"handleAdd\"\n          v-hasPermi=\"['order:supplier:add']\">新增供应商</el-button>\n      </el-col>\n      <el-col :span=\"1.5\">\n        <el-button type=\"success\" plain icon=\"el-icon-edit\" size=\"mini\" :disabled=\"single\" @click=\"handleUpdate\"\n          v-hasPermi=\"['order:supplier:edit']\">编辑</el-button>\n      </el-col>\n\n      <!-- <el-col :span=\"1.5\">\n        <el-button type=\"danger\" plain icon=\"el-icon-delete\" size=\"mini\" :disabled=\"multiple\"\n          @click=\"handleDelete\">删除</el-button>\n      </el-col> -->\n      <el-col :span=\"1.5\">\n        <el-dropdown split-button type=\"primary\" @command=\"handleDropdownClick\" size=\"mini\">\n          批量操作\n          <el-dropdown-menu slot=\"dropdown\">\n            <el-dropdown-item command=\"download\">下载模板</el-dropdown-item>\n            <el-dropdown-item command=\"import\" v-hasPermi=\"['order:supplier:import']\">导入供应商</el-dropdown-item>\n            <el-dropdown-item command=\"export\" v-hasPermi=\"['order:supplier:export']\">导出供应商</el-dropdown-item>\n            <el-dropdown-item command=\"delete\" :disabled=\"multiple\"\n              v-hasPermi=\"['order:supplier:remove']\">删除</el-dropdown-item>\n            <el-dropdown-item command=\"transfer\" :disabled=\"single\"\n              v-hasPermi=\"['order:supplier:transfer']\">转移供应商</el-dropdown-item>\n          </el-dropdown-menu>\n        </el-dropdown>\n      </el-col>\n      <right-toolbar :columns=\"columnList\" :cacheKey=\"cacheKey\" :showSearch.sync=\"showSearch\"\n        @queryTable=\"getList\"></right-toolbar>\n    </el-row>\n\n    <el-table border ref=\"brtTable\" v-loading=\"loading\" :data=\"supplierList\" @selection-change=\"handleSelectionChange\">\n      <el-table-column label=\"序号\" type=\"index\" width=\"50\" align=\"center\" />\n      <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\n\n      <!-- 循环字段 -->\n      <template v-for=\"(item, index) in cacheCloumnList\">\n        <el-table-column v-if=\"item.visible\" :label=\"item.label\" :prop=\"item.prop\" :width=\"item.width || ''\"\n          :align=\"item.align || 'center'\">\n          <template slot=\"header\" slot-scope=\"scope\">\n            {{ item.label }}\n            <el-button v-if=\"item.prop == 'typeVo.typeName'\" @click=\"handleOpenSupplierType\" class=\"mt5 ml5\"\n              icon=\"el-icon-plus\" size=\"mini\" circle v-hasPermi=\"['order:supplierType:list']\"></el-button>\n            <el-button v-if=\"item.prop == 'gradeVo.gradeName'\" @click=\"handleOpenSupplierGrade\" class=\"mt5 ml5\"\n              icon=\"el-icon-plus\" size=\"mini\" circle v-hasPermi=\"['order:supplierGrade:list']\"></el-button>\n          </template>\n          <template slot-scope=\"scope\">\n            <!-- 字典 -->\n            <dict-tag v-if=\"item.type == 'dict'\" :options=\"dict.type[item.dictType]\" :value=\"scope.row[item.prop]\" />\n            <dict-tag v-else-if=\"item.type == 'objDict'\" :options=\"dict.type[item.dictType]\"\n              :value=\"getObjAttr(scope.row, item.prop)\" />\n            <!-- 日期 -->\n            <span v-else-if=\"item.type == 'date'\">{{ parseTime(scope.row[item.prop], item.dateFormat) }}</span>\n            <!-- 图片 -->\n            <image-preview v-else-if=\"item.type == 'img'\" :src=\"scope.row[item.prop]\" :width=\"50\" :height=\"50\" />\n            <!-- 多层对象 -->\n            <span v-else-if=\"item.type == 'obj'\">{{ getObjAttr(scope.row, item.prop) }}</span>\n            <!-- 其他 -->\n            <template v-else-if=\"item.type == 'other'\">\n              <el-button v-if=\"item.prop == 'supplierNo'\" type=\"text\"\n                @click=\"hanldeToHome(scope.row)\">{{ scope.row.supplierNo }}</el-button>\n              <el-button v-if=\"item.prop == 'files'\" type=\"text\" @click=\"hanldeOpenFileList(scope.row)\">查看</el-button>\n            </template>\n            <span v-else>{{ scope.row[item.prop] }}</span>\n          </template>\n        </el-table-column>\n      </template>\n      <!-- <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\n        <template slot-scope=\"scope\">\n          <el-button size=\"mini\" type=\"text\" icon=\"el-icon-edit\" @click=\"handleUpdate(scope.row)\"\n            v-hasPermi=\"['order:supplier:edit']\">修改</el-button>\n          <el-button size=\"mini\" type=\"text\" icon=\"el-icon-delete\" @click=\"handleDelete(scope.row)\"\n            v-hasPermi=\"['order:supplier:remove']\">删除</el-button>\n        </template>\n      </el-table-column> -->\n    </el-table>\n\n    <pagination v-show=\"total > 0\" :total=\"total\" :page.sync=\"queryParams.pageNum\" :limit.sync=\"queryParams.pageSize\"\n      @pagination=\"getList\" />\n\n    <!-- 供应商类型弹框 -->\n    <supplier-type ref=\"supplierTypeRef\"></supplier-type>\n\n    <!-- 供应商等级弹框 -->\n    <supplier-grade ref=\"supplierGreadeRef\"></supplier-grade>\n\n    <!-- 导入对话框 -->\n    <el-dialog :title=\"upload.title\" :visible.sync=\"upload.open\" width=\"400px\" append-to-body>\n      <el-upload ref=\"upload\" :limit=\"1\" accept=\".xlsx, .xls\" :headers=\"upload.headers\" :action=\"upload.url\"\n        :disabled=\"upload.isUploading\" :on-progress=\"handleFileUploadProgress\" :on-success=\"handleFileSuccess\"\n        :auto-upload=\"false\" drag>\n        <i class=\"el-icon-upload\"></i>\n        <div class=\"el-upload__text\">将文件拖到此处，或<em>点击上传</em></div>\n        <div class=\"el-upload__tip text-center\" slot=\"tip\">\n          <span>仅允许导入xls、xlsx格式文件。</span>\n        </div>\n      </el-upload>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button type=\"primary\" @click=\"submitFileForm\">确 定</el-button>\n        <el-button @click=\"upload.open = false\">取 消</el-button>\n      </div>\n    </el-dialog>\n\n    <el-dialog title=\"转移业务员\" :visible.sync=\"transfer.open\" width=\"400px\" append-to-body>\n      <el-form :model=\"transfer.form\" ref=\"transferForm\" size=\"small\" label-width=\"68px\">\n        <el-form-item label=\"业务员\" prop=\"userId\">\n          <el-select v-model=\"transfer.form.userId\" clearable filterable class=\"drag-screenful-contnet\">\n            <el-option v-for=\"(item, index) in salesmanUserList\" :value=\"item.userId\" :label=\"item.userName\"></el-option>\n          </el-select>\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button type=\"primary\" @click=\"submitTransferForm\">确 定</el-button>\n        <el-button @click=\"transfer.open = false\">取 消</el-button>\n      </div>\n    </el-dialog>\n\n    <!-- 文件列表 -->\n    <file-list @updateFile=\"updateSupplierInfo\" ref=\"fileListRef\"></file-list>\n\n  </div>\n</template>\n\n<script>\nimport {\n  listSupplier,\n  listSupplierAll,\n  getSupplier,\n  delSupplier,\n  addSupplier,\n  updateSupplier\n} from \"@/api/order/supplier\";\n\nimport {\n  getToken\n} from \"@/utils/auth\";\n\n\nexport default {\n  name: \"Supplier\",\n  dicts: [\"supplier_type\", \"supplier_payment_type\", \"supplier_grade\"],\n  data() {\n    return {\n      // 遮罩层\n      loading: true,\n      // 选中数组\n      ids: [],\n      // 非单个禁用\n      single: true,\n      // 非多个禁用\n      multiple: true,\n      // 显示搜索条件\n      showSearch: true,\n      // 总条数\n      total: 0,\n      // 供应商信息表格数据\n      supplierList: [],\n      // 查询参数\n      queryParams: {\n        pageNum: 1,\n        pageSize: 10,\n        supplierName: null,\n        supplierNo: null,\n        typeId: null,\n        gradeId: null,\n        contact: null,\n        contactTel: null,\n        userId: null,\n        supplierRemark: null,\n        attachments: null,\n        keyWords: null,\n        dateType: null,\n        createTimes: [],\n        createTimeStart: null,\n        craeteTimeEnd: null\n      },\n      cacheCloumnList: [], //缓存字段列表\n      //缓存名称\n      cacheKey: \"Supplier\",\n      columnList: [\n        {\n          label: \"供应商类别\",\n          prop: \"supplierType\",\n          visible: true,\n          align: \"center\",\n          type: \"dict\",\n          dictType: \"supplier_type\"\n        },\n        {\n          label: \"供应商编号\",\n          prop: \"supplierNo\",\n          visible: true,\n          align: \"center\",\n          type: \"other\"\n        },\n        {\n          label: \"供应商名称\",\n          prop: \"supplierName\",\n          visible: true,\n          align: \"center\",\n        },\n        {\n          label: \"联系人\",\n          prop: \"linkman\",\n          visible: true,\n          align: \"center\",\n        },\n        {\n          label: \"电话\",\n          prop: \"phone\",\n          visible: true,\n          align: \"center\",\n        },\n\n        {\n          label: \"付款方式\",\n          prop: \"paymentType\",\n          visible: true,\n          align: \"center\",\n          type: \"dict\",\n          dictType: \"supplier_payment_type\"\n        },\n        // {\n        //   label: \"付款人\",\n        //   prop: \"payer\",\n        //   visible: true,\n        //   align: \"center\",\n        // },\n        {\n          label: \"付款名称\",\n          prop: \"paymentName\",\n          visible: true,\n          align: \"center\",\n        }, {\n          label: \"账号\",\n          prop: \"account\",\n          visible: true,\n          align: \"center\",\n        }, {\n          label: \"备注\",\n          prop: \"remark\",\n          visible: true,\n          align: \"center\",\n        },\n        {\n          label: \"附件\",\n          prop: \"files\",\n          visible: true,\n          align: \"center\",\n          type: \"other\"\n        },\n      ],\n      // 导入参数\n      upload: {\n        // 是否显示弹出层\n        open: false,\n        // 弹出层标题\n        title: \"\",\n        // 是否禁用上传\n        isUploading: false,\n        // 设置上传的请求头部\n        headers: {\n          Authorization: \"Bearer \" + getToken()\n        },\n        // 上传的地址\n        url: process.env.VUE_APP_BASE_API + \"/order/supplier/importData\"\n      },\n      // 转移参数\n      transfer: {\n        // 是否显示弹出层\n        open: false,\n        // 表单参数\n        form: {\n          supplierId: null,\n          userId: null\n        }\n      },\n      // 供应商类型列表\n      supplierTypeList: [],\n      // 供应商等级列表\n      supplierGradeList: [],\n      // 业务员列表\n      salesmanUserList: [],\n    };\n  },\n\n  watch: {\n    '$route': {\n      handler: function (to, form) {\n        this.onLoad();\n      },\n      immediate: true\n    }\n  },\n\n  created() {\n    this.onLoad();\n  },\n  methods: {\n\n    onLoad() {\n      this.getList();\n      this.refreshCloumn(this);\n    },\n    /**\n     * 去主页\n     */\n    hanldeToHome(row) {\n      this.$router.push({\n        path: '/supplier/home/index',\n        query: {\n          supplierId: row.supplierId,\n          supplierName: row.supplierName\n        }\n      });\n    },\n    /**\n     * 修改供应商信息\n     */\n    updateSupplierInfo(supplier) {\n      updateSupplier(supplier).then(res => {\n        this.$notify({\n          title: '成功',\n          message: '操作成功',\n          type: 'success'\n        });\n        this.getList();\n      })\n    },\n    /**\n     * 打开文件弹框列表\n     */\n    hanldeOpenFileList(row) {\n      this.$refs.fileListRef.handleOpen(row, 'files')\n    },\n    /**\n     * 提交转移\n     */\n    submitTransferForm() {\n      updateSupplier(this.transfer.form).then(res => {\n        this.$notify({\n          title: '成功',\n          message: '操作成功',\n          type: 'success'\n        });\n        this.transfer.open = false;\n        this.getList();\n      })\n    },\n    /**\n     * 转移供应商\n     */\n    handleTransfer() {\n      this.transfer = {\n        open: true,\n        // 表单参数\n        form: {\n          supplierId: this.ids[0],\n          userId: null\n        }\n      }\n    },\n    // 文件上传中处理\n    handleFileUploadProgress(event, file, fileList) {\n      this.upload.isUploading = true;\n    },\n    // 文件上传成功处理\n    handleFileSuccess(response, file, fileList) {\n      this.upload.open = false;\n      this.upload.isUploading = false;\n      this.$refs.upload.clearFiles();\n      this.$alert(response.msg);\n      this.getList();\n    },\n    // 提交上传文件\n    submitFileForm() {\n      this.$refs.upload.submit();\n    },\n    /**\n     * 打开供应商等级弹框\n     */\n    handleOpenSupplierGrade() {\n      this.$refs.supplierGreadeRef.handleOpen();\n    },\n    /**\n     * 打开供应商等级弹框\n     */\n    handleOpenSupplierType() {\n      this.$refs.supplierTypeRef.handleOpen();\n    },\n\n    /**\n     * 批量操作按钮点击事件\n     */\n    handleDropdownClick(command) {\n      switch (command) {\n        case 'download':\n          this.importTemplate();\n          break;\n        case 'import':\n          this.handleImport();\n          break;\n        case 'export':\n          this.handleExport();\n          break;\n        case 'delete':\n          this.handleDelete();\n          break;\n        case 'transfer':\n          this.handleTransfer();\n          break;\n      }\n    },\n    /** 导入按钮操作 */\n    handleImport() {\n      this.upload.title = \"导入\";\n      this.upload.open = true;\n    },\n    /** 下载模板操作 */\n    importTemplate() {\n      this.download('order/supplier/importTemplate', {}, `template_${new Date().getTime()}.xlsx`)\n    },\n    /** 查询供应商信息列表 */\n    getList() {\n      this.loading = true;\n      if (this.queryParams.createTimes != null && this.queryParams.createTimes.length > 0) {\n        this.queryParams.createTimeStart = this.queryParams.createTimes[0]\n        this.queryParams.createTimeEnd = this.queryParams.createTimes[1]\n      } else {\n        this.queryParams.createTimeStart = null\n        this.queryParams.createTimeEnd = null\n      }\n      console.log(this.queryParams)\n      listSupplier(this.queryParams).then(response => {\n        this.supplierList = response.rows;\n        this.total = response.total;\n        this.loading = false;\n      });\n    },\n    /** 搜索按钮操作 */\n    handleQuery() {\n      this.queryParams.pageNum = 1;\n      this.getList();\n    },\n    /** 重置按钮操作 */\n    resetQuery() {\n      this.resetForm(\"queryForm\");\n      this.handleQuery();\n    },\n    // 多选框选中数据\n    handleSelectionChange(selection) {\n      this.ids = selection.map(item => item.supplierId)\n      this.single = selection.length !== 1\n      this.multiple = !selection.length\n    },\n    /** 新增按钮操作 */\n    handleAdd() {\n      this.$router.push({\n        path: '/supplier/info/index',\n      });\n    },\n    /** 修改按钮操作 */\n    handleUpdate() {\n      const supplierId = this.ids[0]\n      this.$router.push({\n        path: '/supplier/info/index',\n        query: {\n          supplierId: supplierId\n        }\n      });\n    },\n    /** 删除按钮操作 */\n    handleDelete(row) {\n      const supplierIds = this.ids;\n      this.$modal.confirm('确认删除？').then(function () {\n        return delSupplier(supplierIds);\n      }).then(() => {\n        this.getList();\n        this.$modal.msgSuccess(\"删除成功\");\n      }).catch(() => { });\n    },\n    /** 导出按钮操作 */\n    handleExport() {\n      this.download('order/supplier/export', {\n        ...this.queryParams,\n        ids: this.ids\n      }, `supplier_${new Date().getTime()}.xlsx`)\n    }\n  }\n};\n</script>\n"]}]}