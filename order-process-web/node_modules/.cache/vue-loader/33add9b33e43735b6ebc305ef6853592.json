A;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"deviceManagement.vue","sourceRoot":"src/views/productionflow","sourcesContent":[" <template>\r\n   <div class=\"device-management\">\r\n     <el-page-header class=\"page-header\" content=\"生产设备管理表\" />\r\n\r\n     <el-card shadow=\"hover\" class=\"section-card\">\r\n       <div slot=\"header\" class=\"section-header\">基础信息</div>\r\n       <div class=\"info-grid\">\r\n         <div v-for=\"item in basicInfo\" :key=\"item.label\" class=\"info-item\">\r\n           <span class=\"label\">{{ item.label }}</span>\r\n           <span class=\"value\" v-html=\"item.value\" />\r\n         </div>\r\n       </div>\r\n     </el-card>\r\n\r\n     <el-card shadow=\"hover\" class=\"section-card\">\r\n       <div slot=\"header\" class=\"section-header\">技术参数</div>\r\n       <div class=\"info-grid\">\r\n         <div v-for=\"item in technicalParams\" :key=\"item.label\" class=\"info-item\">\r\n           <span class=\"label\">{{ item.label }}</span>\r\n           <span class=\"value\">{{ item.value }}</span>\r\n         </div>\r\n       </div>\r\n     </el-card>\r\n\r\n     <el-card shadow=\"hover\" class=\"section-card\">\r\n       <div slot=\"header\" class=\"section-header\">运行状态</div>\r\n       <div class=\"info-grid\">\r\n         <div v-for=\"item in runtimeStatus\" :key=\"item.label\" class=\"info-item\">\r\n           <span class=\"label\">{{ item.label }}</span>\r\n           <span class=\"value\" v-html=\"item.value\" />\r\n         </div>\r\n       </div>\r\n     </el-card>\r\n\r\n     <el-card shadow=\"hover\" class=\"section-card\">\r\n       <div slot=\"header\" class=\"section-header\">维护保养</div>\r\n       <div class=\"info-grid\">\r\n         <div v-for=\"item in maintenancePlan\" :key=\"item.label\" class=\"info-item\">\r\n           <span class=\"label\">{{ item.label }}</span>\r\n           <span class=\"value\">{{ item.value }}</span>\r\n         </div>\r\n       </div>\r\n     </el-card>\r\n\r\n     <el-card shadow=\"hover\" class=\"section-card\">\r\n       <div slot=\"header\" class=\"section-header\">效能分析 (OEE)</div>\r\n       <div class=\"info-grid\">\r\n         <div v-for=\"item in oeeStats\" :key=\"item.label\" class=\"info-item\">\r\n           <span class=\"label\">{{ item.label }}</span>\r\n           <span class=\"value\">{{ item.value }}</span>\r\n         </div>\r\n       </div>\r\n     </el-card>\r\n\r\n     <el-card shadow=\"hover\" class=\"section-card\">\r\n       <div slot=\"header\" class=\"section-header\">维修历史记录（最近3次）</div>\r\n       <el-table :data=\"maintenanceHistory\" border stripe>\r\n         <el-table-column prop=\"date\" label=\"日期\" width=\"140\" />\r\n         <el-table-column prop=\"issue\" label=\"故障现象\" min-width=\"160\" />\r\n         <el-table-column prop=\"cause\" label=\"原因分析\" min-width=\"180\" />\r\n         <el-table-column prop=\"solution\" label=\"处理措施\" min-width=\"200\" />\r\n         <el-table-column prop=\"duration\" label=\"维修时长\" width=\"120\" />\r\n         <el-table-column prop=\"staff\" label=\"维修人\" width=\"120\" />\r\n       </el-table>\r\n     </el-card>\r\n   </div>\r\n </template>\r\n\r\n <script>\r\n   export default {\r\n     name: 'DeviceManagement',\r\n     data() {\r\n       return {\r\n         basicInfo: [{\r\n             label: '资产编号',\r\n             value: 'PE-ASSET-2024-001'\r\n           },\r\n           {\r\n             label: '设备名称',\r\n             value: '五轴立式加工中心'\r\n           },\r\n           {\r\n             label: '设备型号',\r\n             value: 'VM-850'\r\n           },\r\n           {\r\n             label: '设备类别',\r\n             value: '加工中心'\r\n           },\r\n           {\r\n             label: '品牌/制造商',\r\n             value: '发那科'\r\n           },\r\n           {\r\n             label: '序列号',\r\n             value: 'FAN-8X5A-2024-001'\r\n           },\r\n           {\r\n             label: '所属车间',\r\n             value: '一车间A生产线'\r\n           },\r\n           {\r\n             label: '位置',\